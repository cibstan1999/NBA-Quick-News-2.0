}

function loadPublishedEventMemory_() {
  const props = PropertiesService.getScriptProperties();
  const raw = props.getProperty(CONFIG.EVENT_MEMORY_PROPERTY);
  let memory = [];
  if (raw) {
    try {
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed)) memory = parsed;
    } catch (error) {
      Logger.log('⚠️ 事件记忆解析失败，已重置：' + formatError_(error));
    }
  }
  const cutoff =
    new Date().getTime() - CONFIG.EVENT_MEMORY_TTL_HOURS * 60 * 60 * 1000;
  memory = memory
    .filter(function (item) { return item && Number(item.timestamp) >= cutoff; })
    .sort(function (a, b) { return Number(b.timestamp) - Number(a.timestamp); })
