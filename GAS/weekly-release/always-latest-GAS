// ============================================================================
// 🏀 NBA Quick News 2.0 - RSS → Gmail Raw Collector
// Release: 2026-08-06
//
// 职责：只抓取、清洗、排序并投递英文 RSS 原料。
// 不调用 Gemini，不生成中文稿，不直接发布 GitHub Pages。
// 下游由 Codex Automation 读取 Gmail 标签 [NBA-Raw] 后完成筛选、去重、写稿与提交。
// ============================================================================

const FEEDS = [
  { name: "ESPN NBA", url: "https://www.espn.com/espn/rss/nba/news" },
  { name: "RealGM NBA", url: "https://basketball.realgm.com/rss/wiretap/0/0.xml" }
];

const MY_EMAIL = "chronicqqssl@gmail.com";
const PROCESSED_IDS_PROPERTY = "PROCESSED_IDS";
const MAX_PROCESSED_IDS = 5000;
const MAX_CONTENT_CHARS = 3000;
const COLLECTOR_VERSION = "2026-08-06-codex-pipeline";

/**
 * 安装型触发器入口。
 * 建议每 30 分钟运行一次。
 */
function aggregateRssToGmail() {
  const scriptProperties = PropertiesService.getScriptProperties();
  const processedIdsJson = scriptProperties.getProperty(PROCESSED_IDS_PROPERTY);
  let processedIds = processedIdsJson ? JSON.parse(processedIdsJson) : [];
  const processedIdSet = new Set(processedIds);
  const currentRunIdSet = new Set();
  const newItemsToEmail = [];

  FEEDS.forEach(feed => {
    try {
      const response = UrlFetchApp.fetch(feed.url, {
        muteHttpExceptions: true,
        followRedirects: true,
        headers: {
          "User-Agent": "NBA-Quick-News-2.0 RSS Collector"
        }
      });

      const statusCode = response.getResponseCode();
      if (statusCode !== 200) {
        Logger.log(`⚠️ 拉取 [${feed.name}] 失败：HTTP ${statusCode}`);
        return;
      }

      const xml = response.getContentText();
      const document = XmlService.parse(xml);
      const root = document.getRootElement();

      // 兼容 RSS 2.0 (<channel><item>) 与 Atom (<entry>)。
      const channel = root.getChild("channel") || root;
      const items = channel.getChildren("item").concat(channel.getChildren("entry"));

      items.forEach(item => {
        let link = item.getChildText("link") || "";
        if (!link) {
          const linkNode = item.getChild("link");
          if (linkNode) {
            const hrefAttr = linkNode.getAttribute("href");
            if (hrefAttr) link = hrefAttr.getValue();
          }
        }
        link = String(link || "").trim();

        const guid = String(
          item.getChildText("guid") || item.getChildText("id") || link || ""
        ).trim();

        // 跳过历史已投递内容，以及本轮不同来源/节点产生的重复项。
        if (!guid || processedIdSet.has(guid) || currentRunIdSet.has(guid)) return;
        currentRunIdSet.add(guid);

        const title = item.getChildText("title") || "无标题";
        const pubDateStr =
          item.getChildText("pubDate") ||
          item.getChildText("published") ||
          item.getChildText("updated") ||
          "";

        const parsedTimestamp = pubDateStr ? new Date(pubDateStr).getTime() : Date.now();
        const timestamp = Number.isFinite(parsedTimestamp) ? parsedTimestamp : Date.now();

        let content = "";

        // 方法 1：遍历子节点匹配 content / encoded。
        item.getChildren().forEach(child => {
          const name = child.getName();
          if (name === "encoded" || name === "content") content = child.getText();
        });

        // 方法 2：精准匹配 content:encoded 命名空间。
        if (!content) {
          const contentNs = XmlService.getNamespace(
            "http://purl.org/rss/1.0/modules/content/"
          );
          const encodedNode = item.getChild("encoded", contentNs);
          if (encodedNode) content = encodedNode.getText();
        }

        // 方法 3：降级使用 description / summary。
        if (!content) {
          content = item.getChildText("description") || item.getChildText("summary") || "";
        }

        content = cleanHtmlToPlainText(content);
        if (content.length > MAX_CONTENT_CHARS) {
          content =
            content.substring(0, MAX_CONTENT_CHARS) +
            `\n\n...[正文超出 ${MAX_CONTENT_CHARS} 字符，已截断]`;
        }

        newItemsToEmail.push({
          source: feed.name,
          guid: guid,
          fingerprint: generateMaterialFingerprint_(guid, link, title),
          title: cleanHtmlToPlainText(title),
          link: link,
          pubDate: pubDateStr || new Date(timestamp).toISOString(),
          timestamp: timestamp,
          content: content
        });
      });
    } catch (error) {
      Logger.log(`❌ 拉取 [${feed.name}] 异常：${error}`);
    }
  });

  if (newItemsToEmail.length === 0) {
    Logger.log("本次巡检未发现新 RSS 动态。");
    return;
  }

  // 按真实发布时间升序排列（旧 → 新），便于 Codex 按事件演进处理。
  newItemsToEmail.sort((a, b) => a.timestamp - b.timestamp);

  const now = new Date();
  const timezone = Session.getScriptTimeZone();
  const fetchTime = Utilities.formatDate(now, timezone, "yyyy-MM-dd HH:mm:ss");
  const batchId = Utilities.formatDate(now, timezone, "yyyyMMdd-HHmmss");

  let mailBody = "NBA RSS Raw Feed\n\n";
  mailBody += `采集器版本：\n${COLLECTOR_VERSION}\n\n`;
  mailBody += `采集批次：\n${batchId}\n\n`;
  mailBody += `抓取时间：\n${fetchTime}\n\n`;
  mailBody += `共计 ${newItemsToEmail.length} 条更新\n`;
  mailBody += "========================================\n\n";

  newItemsToEmail.forEach((item, index) => {
    mailBody += `${index + 1}.\n`;
    mailBody += `来源：\n${item.source}\n\n`;
    mailBody += `标题：\n${item.title}\n\n`;
    mailBody += `链接：\n${item.link}\n\n`;
    mailBody += `发布时间：\n${item.pubDate}\n\n`;
    mailBody += `原始ID：\n${item.guid}\n\n`;
    mailBody += `素材指纹：\n${item.fingerprint}\n\n`;
    mailBody += `正文：\n${item.content}\n\n`;
    mailBody += "----------------------------------------\n\n";
  });

  const updatedSources = [...new Set(newItemsToEmail.map(item => item.source))].join("+");
  let emailSubject;

  if (newItemsToEmail.length === 1) {
    const safeTitle = truncateSingleLine_(newItemsToEmail[0].title, 110);
    emailSubject = `[NBA-Raw][${newItemsToEmail[0].source}] ${safeTitle}`;
  } else {
    emailSubject =
      `[NBA-Raw][${updatedSources}] 聚合简报 ` +
      `(${newItemsToEmail.length}条更新｜${batchId})`;
  }

  // 必须先成功发送，之后才写入去重历史；发送失败时下轮会自动重试。
  GmailApp.sendEmail(MY_EMAIL, emailSubject, mailBody);

  newItemsToEmail.forEach(item => {
    processedIds.push(item.guid);
    processedIdSet.add(item.guid);
  });

  if (processedIds.length > MAX_PROCESSED_IDS) {
    processedIds = processedIds.slice(processedIds.length - MAX_PROCESSED_IDS);
  }
  scriptProperties.setProperty(PROCESSED_IDS_PROPERTY, JSON.stringify(processedIds));

  Logger.log(
    `[${fetchTime}] 成功投递 ${newItemsToEmail.length} 条更新至 Gmail，批次=${batchId}。`
  );
}

/**
 * 手工体检：不写入 Gmail，只验证 RSS 是否可访问。
 */
function checkRssCollector() {
  Logger.log("====================================================");
  Logger.log(`🏀 NBA RSS Collector 体检：${COLLECTOR_VERSION}`);
  Logger.log(`时区：${Session.getScriptTimeZone()}`);
  Logger.log(`目标邮箱：${MY_EMAIL}`);

  FEEDS.forEach(feed => {
    try {
      const response = UrlFetchApp.fetch(feed.url, { muteHttpExceptions: true });
      Logger.log(`[${feed.name}] HTTP ${response.getResponseCode()}`);
    } catch (error) {
      Logger.log(`[${feed.name}] 异常：${error}`);
    }
  });

  Logger.log("====================================================");
}

function generateMaterialFingerprint_(guid, link, title) {
  const input = [guid || "", link || "", title || ""].join("|");
  const digest = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    input,
    Utilities.Charset.UTF_8
  );

  return digest
    .map(value => {
      const normalized = value < 0 ? value + 256 : value;
      return normalized.toString(16).padStart(2, "0");
    })
    .join("")
    .substring(0, 16);
}

function truncateSingleLine_(value, maxLength) {
  const text = String(value || "").replace(/\s+/g, " ").trim();
  return text.length <= maxLength ? text : text.substring(0, maxLength - 1) + "…";
}

/**
 * 将 HTML 文本转换为干净纯文本。
 */
function cleanHtmlToPlainText(htmlStr) {
  if (!htmlStr) return "";

  return String(htmlStr)
    .replace(/<style[^>]*>[\s\S]*?<\/style>/gi, "")
    .replace(/<script[^>]*>[\s\S]*?<\/script>/gi, "")
    .replace(/<br\s*[\/]?>/gi, "\n")
    .replace(/<\/p>/gi, "\n\n")
    .replace(/<[^>]*>/g, "")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&#x27;/gi, "'")
    .replace(/\n{3,}/g, "\n\n")
    .trim();
}
