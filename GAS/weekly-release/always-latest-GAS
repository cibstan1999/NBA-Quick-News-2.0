function buildJekyllMarkdown_(editorial, article) {
  const formattedDate = Utilities.formatDate(
    new Date(),
    CONFIG.TIMEZONE,
    'yyyy-MM-dd HH:mm:ss'
  );
  const safeTitle = sanitizeYamlTitle_(editorial.title);
  const yamlTags = editorial.tags.map(function (tag) {
    return yamlQuote_(tag);
  }).join(', ');
  const highlightLines = editorial.highlights.map(function (item) {
    return `- ${item}`;
  });
  const reports = getArticleReports_(article);
  const sourceLines = buildSourceLines_(reports);
  const primaryEventTag = editorial.tags.find(function (tag) {
    return ALLOWED_EVENT_TAGS.indexOf(tag) !== -1 && tag !== FALLBACK_EVENT_TAG;
  }) || editorial.tags[0] || FALLBACK_EVENT_TAG;

  return [
    '---',
    'layout: post',
    `title: ${yamlQuote_(safeTitle)}`,
    `date: ${formattedDate} +0800`,
    'categories: [nba, news]',
    `tags: [${yamlTags}]`,
    `news_type: ${yamlQuote_(primaryEventTag)}`,
    `source_name: ${yamlQuote_(article.source)}`,
    `source_title: ${yamlQuote_(article.title)}`,
    `source_url: ${yamlQuote_(article.link)}`,
    `event_core: ${yamlQuote_(editorial.eventCore)}`,
    `event_key: ${yamlQuote_(article.eventDescriptor.eventKey)}`,
    `event_hash: ${yamlQuote_(article.eventDescriptor.eventHash)}`,
    `event_type: ${yamlQuote_(article.eventDescriptor.family)}`,
    `event_stage: ${yamlQuote_(article.eventDescriptor.stage)}`,
    `canonical_topic: ${yamlQuote_(article.eventDescriptor.canonicalTopic || '')}`,
    '---',
    '',
    '### 📌 一句话速览',
    '',
    editorial.summary,
    '',
    '### ⚡ 核心细节拆解',
    '',
    highlightLines.join('\n'),
    '',
    '### 📝 报道正文',
    '',
    editorial.bodyText,
    '',
    '---',
    sourceLines,
    ''
  ].join('\n');
}

function buildSourceLines_(reports) {
  const unique = [];
  const seenLinks = new Set();

  (reports || []).forEach(function (report) {
    const link = String(report.link || '').trim();
    if (!link || seenLinks.has(link)) return;
    seenLinks.add(link);
    unique.push(report);
  });

  if (unique.length <= 1) {
    const report = unique[0];
    return report
      ? `🌐 **原文来源**：[${report.source}](${report.link})`
      : '🌐 **原文来源**：RSS 未提供可靠链接';
  }

  return [
    '🌐 **原文来源**：',
    '',
    unique.slice(0, 5).map(function (report) {
      return `- [${report.source}：${report.title}](${report.link})`;
    }).join('\n')
  ].join('\n');
}

function commitSingleArticleToGithub(content, article, env) {
  const now = new Date();
  const dateString = Utilities.formatDate(now, CONFIG.TIMEZONE, 'yyyy-MM-dd');
  const timeSlug = Utilities.formatDate(now, CONFIG.TIMEZONE, 'HHmmss');
  const sourceHash = generateHash(article.title + article.link);
  const eventHash = article.eventDescriptor.eventHash;
  const filePath =
    `${CONFIG.POSTS_DIR}/${dateString}-nba-news-` +
    `${timeSlug}-${eventHash}-${sourceHash}.md`;

  return putNewGithubFile_(
    filePath,
    content,
    '🤖 [Auto-Post] 发布精品新闻：' + article.title.substring(0, 50),
    env
  );
}

function putNewGithubFile_(filePath, content, commitMessage, env) {
  const encodedPath = encodeGithubPath_(filePath);
  const url =
    'https://api.github.com/repos/' +
    `${encodeURIComponent(env.githubOwner)}/${encodeURIComponent(env.githubRepo)}/` +
    `contents/${encodedPath}`;
  const contentBytes = Utilities.newBlob(content, 'text/plain').getBytes();
  const base64Content = Utilities.base64Encode(contentBytes);
  const commitData = {
    message: commitMessage,
    content: base64Content,
    branch: env.githubBranch
  };

  try {
    const response = UrlFetchApp.fetch(url, {
      method: 'put',
      contentType: 'application/json',
      headers: buildGithubHeaders_(env),
      payload: JSON.stringify(commitData),
      muteHttpExceptions: true
    });
    const statusCode = response.getResponseCode();
    const responseText = response.getContentText();

    if (statusCode === 201 || statusCode === 200) {
      Logger.log(`✅ GitHub 提交成功：${filePath}`);
      return { ok: true, filePath: filePath, error: '' };
    }

    return {
      ok: false,
      filePath: filePath,
      error: `GitHub HTTP ${statusCode}: ${truncateText_(responseText, 1000)}`
    };
  } catch (error) {
    return { ok: false, filePath: filePath, error: formatError_(error) };
  }
}

