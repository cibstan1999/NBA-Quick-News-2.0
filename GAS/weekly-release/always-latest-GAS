function loadRejectedArticleMemory_() {
  const props = PropertiesService.getScriptProperties();
  const raw = props.getProperty(CONFIG.REJECT_MEMORY_PROPERTY);
  let memory = {};
  if (raw) {
    try {
      const parsed = JSON.parse(raw);
      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) memory = parsed;
    } catch (error) {
      Logger.log('⚠️ 拒绝记忆解析失败，已重置：' + formatError_(error));
    }
  }
  const cutoff =
    new Date().getTime() - CONFIG.REJECT_MEMORY_TTL_HOURS * 60 * 60 * 1000;
  let changed = false;
  Object.keys(memory).forEach(function (hash) {
    const rejectedAt = Number(memory[hash]);
    if (!rejectedAt || rejectedAt < cutoff) {
      delete memory[hash];
      changed = true;
    }
  });
  if (changed) saveRejectedArticleMemory_(memory);
  return memory;
}

function isAnyReportRejected_(article, memory) {
  return getArticleReports_(article).some(function (report) {
    return Boolean(memory[generateHash(report.title + report.link)]);
  });
}

function rememberRejectedArticleGroup_(memory, article) {
  const now = new Date().getTime();
  getArticleReports_(article).forEach(function (report) {
    memory[generateHash(report.title + report.link)] = now;
  });
  saveRejectedArticleMemory_(memory);
}

function saveRejectedArticleMemory_(memory) {
  const trimmed = {};
  Object.keys(memory || {})
    .sort(function (a, b) { return Number(memory[b]) - Number(memory[a]); })
    .slice(0, CONFIG.REJECT_MEMORY_MAX_ITEMS)
    .forEach(function (hash) { trimmed[hash] = Number(memory[hash]); });
  PropertiesService.getScriptProperties().setProperty(
    CONFIG.REJECT_MEMORY_PROPERTY,
    JSON.stringify(trimmed)
  );
}

function clearRejectedArticleMemory() {
  PropertiesService.getScriptProperties().deleteProperty(CONFIG.REJECT_MEMORY_PROPERTY);
