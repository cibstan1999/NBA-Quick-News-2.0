function runNbaNewsPipeline() {
  return runAutoNewsPipeline();
}

function runAutoNewsPipeline() {
  const lock = LockService.getScriptLock();
  try {
    if (!lock.tryLock(CONFIG.SCRIPT_LOCK_WAIT_MS)) {
      Logger.log('ℹ️ 已有另一轮任务正在运行，本轮自动退出。');
      return;
    }
    executeNewsPipeline_();
  } catch (error) {
    Logger.log('❌ [Fatal] 主流程发生未捕获异常：' + formatError_(error));
  } finally {
    try {
      if (lock.hasLock()) lock.releaseLock();
    } catch (lockError) {
      Logger.log('⚠️ 释放运行锁失败：' + formatError_(lockError));
    }
  }
}

function checkNbaNewsPipeline() {
  Logger.log('====================================================');
  Logger.log('🩺 开始 NBA Quick News 2.0 系统体检（不调用 Gemini）');
  Logger.log('====================================================');

  const env = getEnvironmentProperties();
  if (!env.isValid) {
    Logger.log('❌ 环境变量不完整，缺少：' + env.missing.join(', '));
    return;
  }

  const configs = loadAllGithubConfigs_(env);
  Logger.log(
    `✅ 配置：黑名单 ${configs.blacklist.length} 条 | ` +
    `球队映射 ${Object.keys(configs.teamMap).length} 条 | ` +
    `词库 ${Object.keys(configs.glossary).length} 条`
  );
  configs.errors.forEach(function (message) { Logger.log('⚠️ ' + message); });

  const historyResult = fetchExistingPostFilenames(env);
  if (!historyResult.ok) {
    Logger.log('❌ GitHub 历史文章检查失败：' + historyResult.error);
    return;
  }

  const existingHashSet = buildExistingHashSet_(historyResult.fileNames);
  const recentEventHashSet = buildRecentEventHashSet_(
    historyResult.fileNames,
    CONFIG.EVENT_DEDUPE_WINDOW_HOURS
  );
  const eventMemory = loadPublishedEventMemory_();
  const rejectedMemory = loadRejectedArticleMemory_();

  Logger.log(`✅ GitHub 历史文章：${historyResult.fileNames.length} 篇`);
  Logger.log(`🧩 最近事件文件哈希：${recentEventHashSet.size} 条`);
  Logger.log(`🧠 最近事件记忆：${eventMemory.length} 条`);

  const rssResult = fetchAndFilterRssArticles(configs.blacklist);
  rssResult.feedStats.forEach(function (stat) {
    Logger.log(
      `📡 ${stat.name}: HTTP ${stat.statusCode || '-'} | ` +
      `读取 ${stat.readCount} | 保留 ${stat.acceptedCount}`
    );
  });

  const groupResult = groupSameEventArticles_(rssResult.articles);
  Logger.log(
    `🧩 RSS ${rssResult.articles.length} 篇整理为 ${groupResult.articles.length} 个事件，` +
    `同轮合并 ${groupResult.duplicateCount} 篇。`
  );

  let exactSkipped = 0;
  let eventSkipped = 0;
  let rejectedSkipped = 0;
  let prefilterSkipped = 0;
  const candidates = [];

  groupResult.articles.forEach(function (article) {
    if (isAnyReportHashKnown_(article, existingHashSet)) {
      exactSkipped++;
      return;
    }
    if (isAnyReportRejected_(article, rejectedMemory)) {
      rejectedSkipped++;
      return;
    }
    const duplicate = findRecentDuplicateEvent_(article, eventMemory, recentEventHashSet);
    if (duplicate.isDuplicate) {
      eventSkipped++;
      return;
    }
    const prefilter = prefilterArticleBeforeGemini_(article);
    if (!prefilter.pass) {
      prefilterSkipped++;
      return;
    }
    candidates.push(article);
  });

  Logger.log(
    `🔎 体检结果：精确历史 ${exactSkipped} | 事件防重 ${eventSkipped} | ` +
    `拒绝记忆 ${rejectedSkipped} | 代码预过滤 ${prefilterSkipped} | ` +
    `可交给 Gemini ${candidates.length}`
  );

  candidates.slice(0, 10).forEach(function (article, index) {
    const d = article.eventDescriptor;
    Logger.log(
      `${index + 1}. [${article.source}] ${article.title} | ` +
      `事件=${d.family}/${d.stage} | 主题=${d.canonicalTopic || '-'} | ` +
      `同事件素材=${getArticleReports_(article).length}`
    );
  });

  Logger.log('====================================================');
  Logger.log('🩺 系统体检结束');
  Logger.log('====================================================');
}

