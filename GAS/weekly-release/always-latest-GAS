      eventCore: { type: 'STRING', description: '不可再缩减的核心事件概括' },
      title: { type: 'STRING', description: '通过时为中文标题，拒绝时为空' },
      summary: { type: 'STRING', description: '通过时为一句话速览，拒绝时为空' },
      highlights: {
        type: 'ARRAY',
        description: '核心细节，拒绝时为空数组',
        items: { type: 'STRING' }
      },
      bodyText: { type: 'STRING', description: '自然段正文，拒绝时为空' },
      tags: {
        type: 'ARRAY',
        description: '可靠中文导航标签，拒绝时为空数组',
        items: { type: 'STRING' }
      }
    },
    required: [
      'isPass', 'reason', 'eventCore', 'title', 'summary',
      'highlights', 'bodyText', 'tags'
    ]
  };

  const payload = {
    contents: [{
      role: 'user',
      parts: [{ text: editorPrompt }, { text: articleMaterial }]
    }],
    generationConfig: {
      temperature: 0.08,
      topP: 0.75,
      maxOutputTokens: CONFIG.GEMINI_MAX_OUTPUT_TOKENS,
      responseMimeType: 'application/json',
      responseSchema: responseSchema
    }
  };

  for (let attempt = 0; attempt <= CONFIG.GEMINI_MAX_RETRIES; attempt++) {
    try {
      Logger.log(`🤖 Gemini 请求：第 ${attempt + 1}/${CONFIG.GEMINI_MAX_RETRIES + 1} 次`);

      const response = UrlFetchApp.fetch(endpoint, {
        method: 'post',
        contentType: 'application/json',
        payload: JSON.stringify(payload),
        muteHttpExceptions: true
      });

      const statusCode = response.getResponseCode();
      const responseText = response.getContentText();

      if (statusCode === 200) {
        const parsedResult = parseGeminiEditorialResponse_(responseText);
        if (parsedResult.ok) {
          return { ok: true, data: parsedResult.data, rateLimited: false, error: '' };
        }
        return { ok: false, data: null, rateLimited: false, error: parsedResult.error };
      }

      const isRateLimited = statusCode === 429;
      const retryable = isRetryableGeminiStatus_(statusCode);
      Logger.log(`⚠️ Gemini HTTP ${statusCode}: ${truncateText_(responseText, 1200)}`);

      if (retryable && attempt < CONFIG.GEMINI_MAX_RETRIES) {
        const waitMs = calculateGeminiRetryWait_(statusCode, response, responseText, attempt);
        Logger.log(`⏳ 等待 ${Math.round(waitMs / 1000)} 秒后重试...`);
        Utilities.sleep(waitMs);
        continue;
      }

      return {
        ok: false,
        data: null,
        rateLimited: isRateLimited,
        error: `Gemini API HTTP ${statusCode}: ${extractGeminiErrorMessage_(responseText)}`
      };
    } catch (error) {
      Logger.log('⚠️ Gemini 网络或解析异常：' + formatError_(error));

      if (attempt < CONFIG.GEMINI_MAX_RETRIES) {
        const waitMs = CONFIG.GEMINI_SERVER_ERROR_WAIT_MS * Math.pow(2, attempt);
        Logger.log(`⏳ 等待 ${Math.round(waitMs / 1000)} 秒后重试...`);
        Utilities.sleep(waitMs);
        continue;
      }

      return { ok: false, data: null, rateLimited: false, error: formatError_(error) };
    }
  }

  return { ok: false, data: null, rateLimited: false, error: 'Gemini 请求在未知状态下结束' };
}

function buildArticleMaterialForPrompt_(article) {
  const reports = getArticleReports_(article);
  const descriptor = article.eventDescriptor;
  const lines = [
    '【待评估事件素材】',
    `代码事件哈希：${descriptor.eventHash}`,
    `代码事件类型：${descriptor.family}/${descriptor.stage}`,
    `代码规范主题：${descriptor.canonicalTopic || '无'}`,
    `代码识别直接球队：${descriptor.primaryTeamKeys.join(',') || '无'}`,
    `同事件报道数量：${reports.length}`
  ];

  reports.forEach(function (report, index) {
    lines.push('');
    lines.push(`【同事件报道 ${index + 1}】`);
    lines.push(`来源：${report.source}`);
    lines.push(`发布时间：${formatArticleDateForPrompt_(report.publishedAt)}`);
    lines.push(`标题：${report.title}`);
    lines.push(`原文链接：${report.link}`);
    lines.push(`正文/摘要：${report.description || '未提供摘要'}`);
  });

  if ((article.moneyFacts || []).length > 1) {
    lines.push('');
    lines.push(
      '【代码提醒】素材中出现多笔金额：' +
      article.moneyFacts.map(formatUsdMillionsForLog_).join('、') +
      '。必须逐笔核对主体和时间，不得默认它们是同一交易的冲突报价。'
    );
  }

  return lines.join('\n');
}

function buildRecentEventsInstruction_(eventMemory) {
  const cutoff =
    new Date().getTime() - CONFIG.EVENT_DEDUPE_WINDOW_HOURS * 60 * 60 * 1000;
  const recent = (eventMemory || [])
    .filter(function (item) { return Number(item.timestamp) >= cutoff; })
    .slice(0, CONFIG.MAX_RECENT_EVENTS_FOR_GEMINI);

  if (recent.length === 0) {
    return [
      '',
      `【最近 ${CONFIG.EVENT_DEDUPE_WINDOW_HOURS} 小时已发布事件】`,
      '事件记忆为空。仍需对本组输入素材内部进行去重。'
    ].join('\n');
  }

  const lines = [
    '',
    `【最近 ${CONFIG.EVENT_DEDUPE_WINDOW_HOURS} 小时已发布事件】`,
    '候选新闻若与下列事件属于同一核心事件且无实质新进展，必须 REJECT：'
  ];

  recent.forEach(function (item, index) {
    lines.push(
      `${index + 1}. ${item.publishedTitle || item.sourceTitle || '未命名事件'} ` +
      `| 核心=${item.eventCore || item.canonicalTopic || '-'} ` +
      `| 类型=${item.family}/${item.stage} ` +
      `| 球队=${(item.primaryTeamKeys || item.teamKeys || []).join(',') || '-'} ` +
      `| 主体=${(item.subjectTokens || []).join(',') || '-'}`
    );
  });

  return lines.join('\n');
}

function parseGeminiEditorialResponse_(responseText) {
  try {
    const payload = JSON.parse(responseText);

    if (!payload.candidates || payload.candidates.length === 0) {
      const blockReason = payload.promptFeedback && payload.promptFeedback.blockReason
        ? payload.promptFeedback.blockReason
        : '未知原因';
      return {
        ok: false,
        data: null,
        error: `Gemini 没有返回候选内容，blockReason=${blockReason}`
      };
    }

    const candidate = payload.candidates[0];
    if (!candidate.content || !Array.isArray(candidate.content.parts)) {
      return {
        ok: false,
        data: null,
        error: 'Gemini 候选内容为空，finishReason=' + String(candidate.finishReason || 'UNKNOWN')
      };
    }

    const text = candidate.content.parts
      .filter(function (part) { return part && typeof part.text === 'string'; })
      .map(function (part) { return part.text; })
      .join('')
      .trim();

    if (!text) return { ok: false, data: null, error: 'Gemini 返回了空文本' };

    const cleanedText = text
      .replace(/^\s*```json\s*/i, '')
      .replace(/^\s*```\s*/i, '')
      .replace(/\s*```\s*$/i, '')
      .trim();

    return { ok: true, data: JSON.parse(cleanedText), error: '' };
  } catch (error) {
    return {
      ok: false,
      data: null,
      error: 'Gemini 结构化响应解析失败：' + formatError_(error)
    };
  }
}

// ============================================================================
// 成稿质量校验
// ============================================================================

function validateEditorialResult_(rawData, fullTeamMap, article) {
  if (!rawData || typeof rawData !== 'object') {
    return { ok: false, data: null, warnings: [], error: '返回结果不是有效对象' };
  }

  const isPass = rawData.isPass === true;
  const reason = sanitizeSingleLine_(rawData.reason);

  if (!isPass) {
    return {
      ok: true,
      data: {
        isPass: false,
        reason: reason || 'REJECT-Gemini 总编拒绝发布',
        eventCore: '',
        title: '',
        summary: '',
        highlights: [],
        bodyText: '',
        tags: []
      },
      warnings: [],
      error: ''
    };
  }

  let editorial = {
    isPass: true,
    reason: reason,
    eventCore: sanitizeSingleLine_(rawData.eventCore),
    title: sanitizeSingleLine_(rawData.title),
    summary: sanitizeSingleLine_(rawData.summary),
    highlights: Array.isArray(rawData.highlights)
      ? rawData.highlights
          .map(sanitizeSingleLine_)
          .filter(function (item) { return item.length > 0; })
          .slice(0, 4)
      : [],
    bodyText: normalizeBodyText_(rawData.bodyText),
    tags: rawData.tags
  };

  const warnings = [];

  if (!editorial.reason) {
    return { ok: false, data: null, warnings: warnings, error: '通过结果缺少 reason' };
  }
  if (!/^FULL-|^BRIEF-/i.test(editorial.reason)) {
    warnings.push('Gemini 通过理由未使用 FULL-/BRIEF- 前缀，但不阻塞发布。');
  }
  if (!editorial.eventCore) {
    return { ok: false, data: null, warnings: warnings, error: '通过结果缺少 eventCore' };
  }
  if (!editorial.title) {
    return { ok: false, data: null, warnings: warnings, error: '通过结果缺少标题' };
  }
  if (editorial.title.length > CONFIG.MAX_TITLE_LENGTH) {
    return { ok: false, data: null, warnings: warnings, error: '标题长度异常' };
  }
  if (!editorial.summary) {
    return { ok: false, data: null, warnings: warnings, error: '通过结果缺少一句话速览' };
  }
  if (editorial.summary.length > CONFIG.MAX_SUMMARY_LENGTH) {
    return { ok: false, data: null, warnings: warnings, error: '一句话速览长度异常' };
  }
  if (editorial.highlights.length < 1 || editorial.highlights.length > 4) {
    return {
      ok: false,
      data: null,
      warnings: warnings,
      error: `核心细节必须为 1 至 4 条，实际为 ${editorial.highlights.length} 条`
    };
  }
  if (!editorial.bodyText || editorial.bodyText.length < CONFIG.MIN_BODY_LENGTH) {
    return { ok: false, data: null, warnings: warnings, error: '正文为空或信息不足，拒绝提交' };
  }

  const outputTextBeforeRepair = [
    editorial.title,
    editorial.summary,
    editorial.highlights.join(' '),
    editorial.bodyText
  ].join(' ');

  const unsafeResult = validateUnsafeOutput_(outputTextBeforeRepair, article);
  if (!unsafeResult.ok) {
    return { ok: false, data: null, warnings: warnings, error: unsafeResult.error };
  }
  Array.prototype.push.apply(warnings, unsafeResult.warnings);

  const moneyResult = repairAndValidateMoneyFacts_(editorial, article);
  if (!moneyResult.ok) {
    return {
      ok: false,
      data: null,
      warnings: warnings.concat(moneyResult.warnings),
      error: moneyResult.error
    };
  }
  editorial = moneyResult.data;
  Array.prototype.push.apply(warnings, moneyResult.warnings);

  const tagResult = normalizeAndRepairTags_(
    editorial.tags,
    fullTeamMap,
    article
  );
  editorial.tags = tagResult.tags;
  Array.prototype.push.apply(warnings, tagResult.warnings);

  if (editorial.tags.length === 0) {
    const fallback = inferPrimaryEventTagFromDescriptor_(article.eventDescriptor);
    if (fallback) {
      editorial.tags.push(fallback);
      warnings.push(`Gemini 未给出可靠标签，代码仅补入“${fallback}”。`);
    }
  }

  if (editorial.tags.length === 0) {
    return { ok: false, data: null, warnings: warnings, error: '无法生成任何可靠导航标签' };
  }

  return {
    ok: true,
    data: {
      isPass: true,
      reason: editorial.reason,
      eventCore: editorial.eventCore,
      title: editorial.title,
      summary: editorial.summary,
      highlights: editorial.highlights,
      bodyText: editorial.bodyText,
      tags: editorial.tags.slice(0, 4)
    },
    warnings: warnings,
    error: ''
  };
}

function validateUnsafeOutput_(outputText, article) {
  const value = String(outputText || '');
  const warnings = [];

  for (let i = 0; i < UNSAFE_OUTPUT_PATTERNS.length; i++) {
    const rule = UNSAFE_OUTPUT_PATTERNS[i];
    if (rule.pattern.test(value)) {
      return { ok: false, warnings: warnings, error: rule.reason };
    }
  }

  const sourceText = getArticleContentText_(article);
  const outputClaimsFirst = /首次|历史首次|史上|历史性|创纪录|前所未有/.test(value);
  const sourceSupportsFirst = /\bfirst time\b|\bhistoric\b|\bfor the first time\b|\brecord[- ]setting\b|\bunprecedented\b/i.test(sourceText);

  if (outputClaimsFirst && !sourceSupportsFirst) {
    return {
      ok: false,
      warnings: warnings,
      error: '成稿使用“首次/历史性/史上”等强化判断，但原始素材没有明确支持'
    };
  }

  if (/某队|神秘球队|新的西部竞争对手|一支西部球队/.test(value)) {
    return {
      ok: false,
      warnings: warnings,
      error: '成稿保留未具名核心对象，信息不完整'
    };
  }

  return { ok: true, warnings: warnings, error: '' };
}

function repairAndValidateMoneyFacts_(editorial, article) {
  const sourceFacts = (article.moneyFacts || []).slice();
  const warnings = [];
  const data = {
    isPass: editorial.isPass,
    reason: editorial.reason,
    eventCore: editorial.eventCore,
    title: editorial.title,
    summary: editorial.summary,
    highlights: editorial.highlights.slice(),
    bodyText: editorial.bodyText,
    tags: editorial.tags
  };

  sourceFacts.forEach(function (expectedMillions) {
    data.title = repairMillionUnitMistake_(data.title, expectedMillions);
    data.summary = repairMillionUnitMistake_(data.summary, expectedMillions);
    data.highlights = data.highlights.map(function (item) {
      return repairMillionUnitMistake_(item, expectedMillions);
    });
    data.bodyText = repairMillionUnitMistake_(data.bodyText, expectedMillions);
  });

  const outputText = [
    data.title,
    data.summary,
    data.highlights.join(' '),
    data.bodyText
  ].join(' ');

  const outputFacts = collectChineseMoneyFacts_(outputText);

  if (outputFacts.length > 0 && sourceFacts.length === 0) {
    return {
      ok: false,
      data: null,
      warnings: warnings,
      error: '成稿新增了原始素材中不存在的美元金额'
    };
  }

  const unsupportedOutputAmount = outputFacts.find(function (outputAmount) {
    return !sourceFacts.some(function (sourceAmount) {
      return moneyAmountsClose_(sourceAmount, outputAmount);
    });
  });

  if (typeof unsupportedOutputAmount === 'number') {
    return {
      ok: false,
      data: null,
      warnings: warnings,
      error: '成稿中的美元金额与输入素材不一致，已停止提交'
    };
  }

  const originalText = [
    editorial.title,
    editorial.summary,
    editorial.highlights.join(' '),
    editorial.bodyText
  ].join(' ');
  if (originalText !== outputText) {
    warnings.push('代码已自动修复 million → 万美元的单位换算错误。');
  }

  if (sourceFacts.length > 1) {
    warnings.push('素材包含多笔金额，已逐笔验证成稿金额均能在原始素材中找到。');
  }

  return { ok: true, data: data, warnings: warnings, error: '' };
}

function repairMillionUnitMistake_(text, expectedMillions) {
  let result = String(text || '');
  const sourceNumber = trimTrailingZeros_(expectedMillions);
  const expectedWan = trimTrailingZeros_(expectedMillions * 100);
  const wrongPattern = new RegExp(
    '(^|[^0-9])' + escapeRegExp_(sourceNumber) + '\\s*万\\s*美(?:元|金)',
    'g'
  );

  result = result.replace(wrongPattern, function (match, prefix) {
    return prefix + expectedWan + '万美元';
  });

  return result;
}

function collectMoneyFactsFromReports_(reports) {
  const values = [];

  (reports || []).forEach(function (report) {
    collectMoneyFactsFromText_(`${report.title || ''} ${report.description || ''}`)
      .forEach(function (amount) {
        if (!values.some(function (existing) { return moneyAmountsClose_(existing, amount); })) {
          values.push(amount);
        }
      });
  });

  return values.sort(function (a, b) { return a - b; });
}

function collectMoneyFactsFromText_(text) {
  const value = String(text || '');
  const result = [];
  const pattern = /\$(\d+(?:\.\d+)?)\s*(billion|million|bn|m|b)\b/gi;
  let match;

  while ((match = pattern.exec(value)) !== null) {
    const number = Number(match[1]);
    const unit = String(match[2] || '').toLowerCase();
    if (!isFinite(number)) continue;

    let millions = number;
    if (unit === 'billion' || unit === 'bn' || unit === 'b') {
      millions = number * 1000;
    }
    result.push(roundMoney_(millions));
  }

  return result;
}

function collectChineseMoneyFacts_(text) {
  const value = String(text || '');
  const result = [];
  const pattern = /(\d+(?:\.\d+)?)\s*(亿|万)?\s*美(?:元|金)/g;
  let match;

  while ((match = pattern.exec(value)) !== null) {
    const number = Number(match[1]);
    const unit = match[2] || '';
    if (!isFinite(number)) continue;

    let millions;
    if (unit === '亿') millions = number * 100;
    else if (unit === '万') millions = number / 100;
    else millions = number / 1000000;
    result.push(roundMoney_(millions));
  }

  return result;
}

function moneyAmountsClose_(a, b) {
  const left = Number(a);
  const right = Number(b);
  const absoluteTolerance = 0.03;
  const relativeTolerance = Math.max(Math.abs(left), Math.abs(right)) * 0.002;
  return Math.abs(left - right) <= Math.max(absoluteTolerance, relativeTolerance);
}

function roundMoney_(value) {
  return Math.round(Number(value) * 1000) / 1000;
}

function formatUsdMillionsForLog_(millions) {
  if (millions >= 1000) {
    return '$' + trimTrailingZeros_(millions / 1000) + ' billion';
  }
  return '$' + trimTrailingZeros_(millions) + ' million';
}

function trimTrailingZeros_(value) {
  return String(Math.round(Number(value) * 1000) / 1000).replace(/\.0+$/, '');
}

// ============================================================================
// 标签反向校验
// ============================================================================

function normalizeAndRepairTags_(rawTags, fullTeamMap, article) {
  const warnings = [];
  const sourceText = getArticleContentText_(article);
  const sourceTitle = getArticleReports_(article).map(function (report) {
    return report.title || '';
  }).join(' ');
  const sourceLead = getArticleReports_(article).map(function (report) {
    return firstSentence_(report.description || '');
  }).join(' ');

  const directTeamKeys = Array.from(new Set(
    detectTeamKeys_(sourceTitle).concat(detectTeamKeys_(sourceLead))
  ));
  const teamTagMap = buildTeamTagMap_(fullTeamMap);
  const allowedDirectTeamTags = new Set();

  directTeamKeys.forEach(function (teamKey) {
    const tag = teamTagMap.byKey[teamKey];
    if (tag) allowedDirectTeamTags.add(tag);
  });

  const supportedEventTags = new Set(inferEventTagsFromSource_(sourceText, article));
  const uniqueTags = [];
  const originalTags = Array.isArray(rawTags) ? rawTags : [];

  originalTags.forEach(function (rawTag) {
    const tag = sanitizeSingleLine_(rawTag).replace(/^#/, '').trim();
    if (!tag) return;

    const isDirectTeamTag = allowedDirectTeamTags.has(tag);
    const isSupportedEventTag = supportedEventTags.has(tag);
    const isSupportedSubject = isSupportedSubjectTag_(tag, sourceTitle + ' ' + sourceLead);

    if (!isDirectTeamTag && !isSupportedEventTag && !isSupportedSubject) {
      return;
    }

    if (uniqueTags.indexOf(tag) === -1) uniqueTags.push(tag);
  });

  // 事件直接相关球队优先补入；只在标题/首句中出现，避免把履历前东家当标签。
  directTeamKeys.forEach(function (teamKey) {
    const tag = teamTagMap.byKey[teamKey];
    if (tag && uniqueTags.length < 4 && uniqueTags.indexOf(tag) === -1) {
      uniqueTags.push(tag);
    }
  });

  inferEventTagsFromSource_(sourceText, article).forEach(function (tag) {
    if (uniqueTags.length < 4 && uniqueTags.indexOf(tag) === -1) {
      uniqueTags.push(tag);
    }
  });

  if (!Array.isArray(rawTags)) {
    warnings.push('Gemini 未返回标签数组，代码已重新生成标签。');
  } else {
    const normalizedOriginalCount = originalTags
      .map(sanitizeSingleLine_)
      .filter(Boolean).length;
    if (uniqueTags.length !== normalizedOriginalCount) {
      warnings.push('Gemini 标签已由代码反向校验；无证据球队、弱关联前东家和错误事件标签已移除。');
    }
  }

  return { tags: uniqueTags.slice(0, 4), warnings: warnings };
}

function buildTeamTagMap_(teamMap) {
  const byKey = {};
  const byTag = {};

  Object.keys(teamMap || {}).forEach(function (key) {
    const normalizedKey = normalizeTeamKey_(key, teamMap[key]);
    const preferred = getPreferredTeamTag_(key, teamMap[key]);
    if (!normalizedKey || !preferred || !containsChinese_(preferred)) return;
    byKey[normalizedKey] = preferred;
    byTag[preferred] = normalizedKey;
  });

  return { byKey: byKey, byTag: byTag };
}

function normalizeTeamKey_(key, value) {
  const cleanKey = sanitizeSingleLine_(key).toUpperCase();
  if (NBA_TEAM_ALIASES[cleanKey]) return cleanKey;

  const terms = collectSearchableTerms_(key, value).join(' ');
  const detected = detectTeamKeys_(terms);
  return detected.length === 1 ? detected[0] : '';
}

function getPreferredTeamTag_(key, value) {
  if (typeof value === 'string') {
    return containsChinese_(value) ? value.trim() : sanitizeSingleLine_(key);
  }

  if (Array.isArray(value)) {
    const chineseItems = value
      .map(sanitizeSingleLine_)
      .filter(function (item) { return containsChinese_(item); });
    if (chineseItems.length > 0) return chineseItems[0];
    return containsChinese_(key) ? sanitizeSingleLine_(key) : '';
  }

  if (value && typeof value === 'object') {
    const preferredFields = ['chinese', 'zh', 'shortName', 'displayName', 'name'];
    for (let i = 0; i < preferredFields.length; i++) {
      const fieldValue = value[preferredFields[i]];
      if (
        typeof fieldValue === 'string' &&
        fieldValue.trim() &&
        containsChinese_(fieldValue)
      ) {
        return fieldValue.trim();
      }
    }

    const terms = collectSearchableTerms_(key, value);
    const chineseTerm = terms.find(function (item) { return containsChinese_(item); });
    if (chineseTerm) return sanitizeSingleLine_(chineseTerm);
  }

  return containsChinese_(key) ? sanitizeSingleLine_(key) : '';
}

function inferEventTagsFromSource_(text, article) {
  const value = String(text || '');
  const result = [];

  const add = function (tag) {
    if (result.indexOf(tag) === -1 && result.length < 3) result.push(tag);
  };

  if (/\btrade rumor\b|\btrade target\b|\blinked to\b|\binterested in\b|\bcould be traded\b/i.test(value)) {
    add('交易流言');
  } else if (/\btraded?\b|\bacquire(?:s|d)?\b|\bdeal sends\b|\btrade sends\b/i.test(value)) {
    add('交易');
  }

  if (/\bre-?sign(?:s|ed|ing)?\b|\bcontract extension\b|\bextended\b/i.test(value)) {
    add('续约');
  } else if (
    /\bsign(?:s|ed|ing)?\b|\bagree(?:s|d)? to (?:a |an )?(?:contract|deal|two-way)\b|\btwo-way contract\b|\b10-day contract\b/i.test(value)
  ) {
    add('签约');
  }

  if (/\bwaive(?:s|d)?\b|\brelease(?:s|d)?\b|\broster cut\b/i.test(value)) add('裁员');
  if (/\binjur(?:y|ies|ed)\b|\bsurgery\b|\bout for\b|\bdiagnos(?:is|ed)\b|\btorn\b/i.test(value)) add('伤病');
  if (/\bcleared to play\b|\bback in the lineup\b|\breturn(?:s|ed|ing)? from injury\b/i.test(value)) add('复出');
  if (/\bsuspend(?:s|ed|ing|sion)?\b|\bbanned\b/i.test(value)) add('停赛');
  if (/\binvestigat(?:e|es|ed|ion)\b|\bprobe\b/i.test(value)) add('调查');
  if (/\bfine(?:d)?\b|\bpenalt(?:y|ies)\b|\bdisciplin(?:e|ary)\b/i.test(value)) add('处罚');

  const legalRelevant =
    /\blawsuit\b|\bcriminal court\b|\bcriminal charges?\b|\bindict(?:ed|ment)?\b|\blegal action\b|\bcontract dispute\b|\blabor dispute\b/i.test(value) &&
    BASKETBALL_IMPACT_PATTERNS.some(function (pattern) { return pattern.test(value); });
  if (legalRelevant) add('法律事务');

  if (/\bNBA head coach\b|\bNBA coaching staff\b|\bfires? coach\b|\bcoach(?:ing)? hire\b/i.test(value)) add('主教练');
  if (/\bgeneral manager\b|\bpresident of basketball\b|\bfront office\b|\bexecutive\b/i.test(value)) add('管理层');
  if (/\bNBA draft\b|\bfirst-round pick\b|\bsecond-round pick\b|\bdraft prospect\b/i.test(value)) add('选秀');
  if (/\bsalary cap\b|\bluxury tax\b|\bsecond apron\b/i.test(value)) add('工资帽');
  if (/\bcollective bargaining agreement\b|\blabor agreement\b/i.test(value)) add('劳资协议');
  if (/\bfree agency\b|\bfree agent\b/i.test(value)) add('自由市场');
  if (/\barena\b|\bstadium\b|\brenovation\b/i.test(value)) add('球馆');
  if (/\bownership\b|\bteam sale\b|\bfranchise sale\b|\bpublic funding\b/i.test(value)) add('球队经营');
  if (/\brelocat(?:e|ion)\b|\bmove the team\b/i.test(value)) add('搬迁');
  if (/\bretire(?:s|d|ment)?\b/i.test(value)) add('退役');
  if (/\bofficially\b|\bofficial announcement\b|\bteam announced\b/i.test(value)) add('官宣');
  if (/\bdefeat(?:s|ed)?\b|\bbeats?\b|\bfinal score\b/i.test(value)) add('比赛');
  if (/\bcareer-high\b|\btriple-double\b|\bdouble-double\b/i.test(value)) add('数据表现');
  if (/\bcontender\b|\boutlook\b|\bexpectations?\b/i.test(value)) add('球队前景');

  if (
    article && article.eventDescriptor &&
    (article.eventDescriptor.family === 'analysis' || article.eventDescriptor.type === 'trend')
  ) {
    add('趋势分析');
  }

  if (
    article && article.eventDescriptor &&
    article.eventDescriptor.family === 'policy'
  ) {
    add('联盟政策');
  }

  if (result.length === 0 && /\bcontract\b|\bdeal\b/i.test(value)) add('合同');

  return result;
}

function inferPrimaryEventTagFromDescriptor_(descriptor) {
  const map = {
    extension: '续约',
    signing: '签约',
    trade_rumor: '交易流言',
    trade: '交易',
    waiver: '裁员',
    injury: '伤病',
    return: '复出',
    suspension: '停赛',
    coach: '主教练',
    executive: '管理层',
    draft: '选秀',
    investigation: '调查',
    legal: '法律事务',
    arena: '球馆',
    ownership: '球队经营',
    retirement: '退役',
    game: '比赛',
    comment: '球员言论',
    policy: '联盟政策',
    trend: '趋势分析',
    general: FALLBACK_EVENT_TAG
  };

  return map[descriptor && descriptor.type] || FALLBACK_EVENT_TAG;
}

function isSupportedSubjectTag_(tag, text) {
  const cleanTag = sanitizeSingleLine_(tag);
  if (cleanTag.length < 2 || cleanTag.length > 18) return false;
  if (/https?:|www\.|[#@]/i.test(cleanTag)) return false;
  if (!/[\u3400-\u9fff]/.test(cleanTag)) return false;
  if (/球队动态|克利夫兰|华盛顿|洛杉矶|纽约|波士顿|迈阿密|芝加哥/.test(cleanTag)) {
    return false;
  }

  const normalizedTag = normalizeCompactText_(cleanTag);
  const normalizedText = normalizeCompactText_(text);
  return normalizedTag.length >= 2 && normalizedText.indexOf(normalizedTag) !== -1;
}

function firstSentence_(text) {
  const value = String(text || '').trim();
  if (!value) return '';
  const match = value.match(/^([\s\S]*?[.!?。！？])(?:\s|$)/);
  return match ? match[1] : value;
}

// ============================================================================
// Markdown 生成与 GitHub 发布
