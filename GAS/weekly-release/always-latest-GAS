    `contents/${encodedPath}`;
  const contentBytes = Utilities.newBlob(content, 'text/plain').getBytes();
  const base64Content = Utilities.base64Encode(contentBytes);
  const commitData = {
    message: '🤖 [Auto-Post] 发布精品新闻：' + article.title.substring(0, 50),
    content: base64Content,
    branch: env.githubBranch
  };
  try {
    const response = UrlFetchApp.fetch(url, {
