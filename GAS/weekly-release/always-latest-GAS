function executeNewsPipeline_() {
  const run = {
    runId: Utilities.getUuid().substring(0, 8),
    startedAt: new Date(),
    rejections: [],
    metrics: {
      exactHistory: 0,
      eventDuplicate: 0,
      rejectedMemory: 0,
      prefiltered: 0,
      geminiAttempted: 0,
      geminiRejected: 0,
      validationFailed: 0,
      technicalFailed: 0,
      published: 0
    }
  };

  let env = null;
  let rateLimitCircuitBroken = false;

  Logger.log('====================================================');
  Logger.log(`🚀 [RunID:${run.runId}] 开始执行 NBA 自动新闻工作流`);
  Logger.log('====================================================');

  try {
    env = getEnvironmentProperties();
    if (!env.isValid) {
      Logger.log('❌ [Fatal] 环境变量配置不完整，缺少：' + env.missing.join(', '));
      return;
    }

    Logger.log('📥 正在从 GitHub 加载 configs/ 配置文件...');
    const configs = loadAllGithubConfigs_(env);
    const blacklist = configs.blacklist;
    const teamMap = configs.teamMap;
    const glossary = configs.glossary;

    Logger.log(
      `✅ 配置加载完成：黑名单 ${blacklist.length} 条 | ` +
      `球队映射 ${Object.keys(teamMap).length} 条 | ` +
      `词库 ${Object.keys(glossary).length} 条`
    );
    configs.errors.forEach(function (message) { Logger.log('⚠️ ' + message); });

    Logger.log('📡 正在抓取 RSS 新闻源...');
    const rssResult = fetchAndFilterRssArticles(blacklist);
    rssResult.feedStats.forEach(function (stat) {
      Logger.log(
        `📡 ${stat.name}: 读取 ${stat.readCount} 篇，基础清洗后保留 ` +
        `${stat.acceptedCount} 篇`
      );
    });

    const groupResult = groupSameEventArticles_(rssResult.articles);
    const groupedArticles = groupResult.articles;
    Logger.log(
      `🧩 同一轮事件分组：${rssResult.articles.length} 篇 RSS 报道 → ` +
      `${groupedArticles.length} 个事件，合并 ${groupResult.duplicateCount} 篇重复报道。`
    );

    if (groupedArticles.length === 0) {
      Logger.log('ℹ️ 当前没有有效 RSS 新闻，本轮结束。');
      return;
    }

    Logger.log('🔍 正在读取 GitHub 历史文章列表...');
    const historyResult = fetchExistingPostFilenames(env);
    if (!historyResult.ok) {
      Logger.log('❌ [Fatal] 无法可靠读取 GitHub 历史文章，为防止重复发布，本轮主动终止。');
      Logger.log('❌ 具体原因：' + historyResult.error);
      return;
    }

    const existingHashSet = buildExistingHashSet_(historyResult.fileNames);
    const recentEventHashSet = buildRecentEventHashSet_(
      historyResult.fileNames,
      CONFIG.EVENT_DEDUPE_WINDOW_HOURS
    );
    const rejectedMemory = loadRejectedArticleMemory_();
    const eventMemory = loadPublishedEventMemory_();

    Logger.log(`✅ 已读取 ${historyResult.fileNames.length} 个历史文章文件`);
    Logger.log(
      `🧠 最近 ${CONFIG.EVENT_DEDUPE_WINDOW_HOURS} 小时事件：` +
      `文件哈希 ${recentEventHashSet.size} 条 | 事件记忆 ${eventMemory.length} 条`
    );

    const newArticles = [];

    groupedArticles.forEach(function (article) {
      if (isAnyReportHashKnown_(article, existingHashSet)) {
        run.metrics.exactHistory++;
        return;
      }

      if (isAnyReportRejected_(article, rejectedMemory)) {
        run.metrics.rejectedMemory++;
        return;
      }

      const duplicate = findRecentDuplicateEvent_(article, eventMemory, recentEventHashSet);
      if (duplicate.isDuplicate) {
        run.metrics.eventDuplicate++;
        recordRejection_(run, article, '跨来源同事件重复', duplicate.reason, {
          duplicateOf: duplicate.matchedTitle || '',
          suspectedFalsePositive: false
        });
        rememberRejectedArticleGroup_(rejectedMemory, article);
        Logger.log(`🧱 事件防重跳过：[${article.source}] ${article.title} | ${duplicate.reason}`);
        return;
      }

      newArticles.push(article);
    });

    if (newArticles.length === 0) {
      Logger.log(
        `🎉 没有需要调用 Gemini 的新事件。精确历史 ${run.metrics.exactHistory} | ` +
        `事件防重 ${run.metrics.eventDuplicate} | 拒绝记忆 ${run.metrics.rejectedMemory}`
      );
      return;
    }

    Logger.log(
      `📰 发现 ${newArticles.length} 个新事件候选，本轮目标发布 ` +
      `${CONFIG.MAX_ARTICLES_PER_RUN} 篇。`
    );

    let lastGeminiRequestAt = 0;

    for (let index = 0; index < newArticles.length; index++) {
      if (run.metrics.published >= CONFIG.MAX_ARTICLES_PER_RUN) break;

      const article = newArticles[index];
      const reports = getArticleReports_(article);
      const descriptor = article.eventDescriptor;

      Logger.log('');
      Logger.log('----------------------------------------------------');
      Logger.log(
        `🔄 候选事件 ${index + 1}/${newArticles.length} | ` +
        `已发布 ${run.metrics.published}/${CONFIG.MAX_ARTICLES_PER_RUN}`
      );
      Logger.log(`📰 [${article.source}] ${article.title}`);
      Logger.log(
        `🧩 事件：${descriptor.family}/${descriptor.stage} | ` +
        `主题=${descriptor.canonicalTopic || '-'} | 同事件素材 ${reports.length} 篇`
      );

      const prefilterResult = prefilterArticleBeforeGemini_(article);
      if (!prefilterResult.pass) {
        run.metrics.prefiltered++;
        recordRejection_(run, article, prefilterResult.stage || '基础规则过滤', prefilterResult.reason, {
          suspectedFalsePositive: Boolean(prefilterResult.suspectedFalsePositive)
        });
        rememberRejectedArticleGroup_(rejectedMemory, article);
        Logger.log(`🧹 代码预过滤拒绝，不调用 Gemini：${prefilterResult.reason}`);
        continue;
      }

      run.metrics.geminiAttempted++;

      const relevantTeamMap = selectRelevantEntries_(
        teamMap,
        article,
        CONFIG.MAX_TEAM_MAP_ITEMS_PER_ARTICLE
      );
      const relevantGlossary = selectRelevantEntries_(
        glossary,
        article,
        CONFIG.MAX_GLOSSARY_ITEMS_PER_ARTICLE
      );

      Logger.log(
        `📚 本篇携带：球队映射 ${Object.keys(relevantTeamMap).length} 条 | ` +
        `专有词库 ${Object.keys(relevantGlossary).length} 条`
      );

      lastGeminiRequestAt = waitForGeminiInterval_(lastGeminiRequestAt);
      const editorialResult = processArticleWithGeminiEditor_(
        article,
        relevantTeamMap,
        relevantGlossary,
        eventMemory,
        env.geminiApiKey
      );
      lastGeminiRequestAt = new Date().getTime();

      if (!editorialResult.ok) {
        run.metrics.technicalFailed++;
        recordRejection_(run, article, 'API 或处理异常', editorialResult.error || '未知错误', {
          suspectedFalsePositive: true
        });
        Logger.log(`❌ Gemini 处理失败：${editorialResult.error || '未知错误'}`);

        if (editorialResult.rateLimited) {
          rateLimitCircuitBroken = true;
          Logger.log('🛑 Gemini 持续返回 429，本轮熔断，剩余事件留给下次运行。');
          break;
        }
        continue;
      }

      if (!editorialResult.data.isPass) {
        run.metrics.geminiRejected++;
        const rejectReason =
          sanitizeSingleLine_(editorialResult.data.reason) || 'REJECT-Gemini 总编拒绝发布';
        recordRejection_(run, article, 'Gemini 退稿', rejectReason, {
          geminiReason: rejectReason,
          suspectedFalsePositive: shouldFlagPossibleFalsePositive_(rejectReason)
        });
        rememberRejectedArticleGroup_(rejectedMemory, article);
        Logger.log(`🚫 Gemini 总编拒绝发布：${rejectReason}`);
        continue;
      }

      const validationResult = validateEditorialResult_(
        editorialResult.data,
        teamMap,
        article
      );

      if (!validationResult.ok) {
        run.metrics.validationFailed++;
        recordRejection_(run, article, '发布前质量校验', validationResult.error, {
          geminiReason: sanitizeSingleLine_(editorialResult.data.reason),
          suspectedFalsePositive: true
        });
        Logger.log(`❌ Gemini 成品未通过质量校验：${validationResult.error}`);
        continue;
      }

      validationResult.warnings.forEach(function (warning) {
        Logger.log('⚠️ ' + warning);
      });

      const markdown = buildJekyllMarkdown_(validationResult.data, article);
      Logger.log(`✅ Gemini 总编通过：${validationResult.data.reason}`);
      Logger.log(`🏷️ 标签：${validationResult.data.tags.join('、')}`);
      Logger.log('📤 正在提交 GitHub...');

      const commitResult = commitSingleArticleToGithub(markdown, article, env);
      if (commitResult.ok) {
        run.metrics.published++;
        getArticleReports_(article).forEach(function (report) {
          existingHashSet.add(generateHash(report.title + report.link));
        });
        recentEventHashSet.add(descriptor.eventHash);
        rememberPublishedEvent_(
          eventMemory,
          article,
          validationResult.data.title,
          validationResult.data.eventCore
        );
        Logger.log(
          `✅ 发布成功：${run.metrics.published}/${CONFIG.MAX_ARTICLES_PER_RUN} | ` +
          `事件哈希 ${descriptor.eventHash}`
        );
      } else {
        run.metrics.technicalFailed++;
        recordRejection_(run, article, 'GitHub 提交异常', commitResult.error, {
          suspectedFalsePositive: true
        });
        Logger.log('❌ GitHub 提交失败：' + commitResult.error);
      }
    }
  } catch (error) {
    run.metrics.technicalFailed++;
    Logger.log('❌ [Fatal] executeNewsPipeline_ 异常：' + formatError_(error));
  } finally {
    if (env && env.isValid) {
      const archiveResult = commitRejectionArchiveToGithub_(run, env);
      if (!archiveResult.ok && run.rejections.length > 0) {
        Logger.log('⚠️ 退稿档案写入失败，但不影响新闻发布：' + archiveResult.error);
      }
    }

    const elapsedSeconds = Math.round(
      (new Date().getTime() - run.startedAt.getTime()) / 1000
    );

    Logger.log('');
    Logger.log('====================================================');
    Logger.log(
      `🎉 [RunID:${run.runId}] 工作流结束：调用 Gemini ${run.metrics.geminiAttempted} | ` +
      `精确历史 ${run.metrics.exactHistory} | 事件防重 ${run.metrics.eventDuplicate} | ` +
      `拒绝记忆 ${run.metrics.rejectedMemory} | 代码预过滤 ${run.metrics.prefiltered} | ` +
      `Gemini 退稿 ${run.metrics.geminiRejected} | 质量拦截 ${run.metrics.validationFailed} | ` +
      `成功发布 ${run.metrics.published} | 技术失败 ${run.metrics.technicalFailed} | ` +
      `退稿档案 ${run.rejections.length} 条 | 耗时 ${elapsedSeconds} 秒`
    );
    if (rateLimitCircuitBroken) Logger.log('⚠️ 本轮因 Gemini 持续限流提前结束。');
    Logger.log('====================================================');
  }
}

// ============================================================================
// 同事件分组与事件指纹
// ============================================================================

function groupSameEventArticles_(articles) {
  const groups = [];

  (articles || []).forEach(function (article) {
    article.eventDescriptor = buildEventDescriptor_(article);
    let matchedGroup = null;

    for (let i = 0; i < groups.length; i++) {
      if (areEventDescriptorsSame_(
        article.eventDescriptor,
        groups[i].representativeDescriptor
      )) {
        matchedGroup = groups[i];
        break;
      }
    }

    if (matchedGroup) {
      matchedGroup.reports.push(article);
    } else {
      groups.push({
        representativeDescriptor: article.eventDescriptor,
        reports: [article]
      });
    }
  });

  const groupedArticles = groups.map(function (group) {
    return finalizeArticleGroup_(group.reports);
  });

  return {
    articles: groupedArticles,
    duplicateCount: Math.max(0, (articles || []).length - groupedArticles.length)
  };
}

function finalizeArticleGroup_(reports) {
  const sortedReports = (reports || []).slice().sort(function (a, b) {
    return scoreReportForGroup_(b) - scoreReportForGroup_(a);
  });

  const primary = sortedReports[0];
  primary.relatedReports = sortedReports.slice(1);
  primary.eventDescriptor = buildEventDescriptor_(primary);
  primary.moneyFacts = collectMoneyFactsFromReports_(sortedReports);
  return primary;
}

function scoreReportForGroup_(article) {
  const descriptor = article.eventDescriptor || buildEventDescriptor_(article);
  const sourcePriority =
    article.source === 'RealGM Wiretap' ? 120 :
    article.source === 'Yahoo Sports NBA' ? 80 : 50;
  const descriptionScore = Math.min(
    120,
    Math.round(String(article.description || '').length / 8)
  );
  const recencyScore = article.publishedAtMs
    ? Math.floor(article.publishedAtMs / 100000000)
    : 0;

  return (
    eventStageRank_(descriptor.stage) * 1000 +
    sourcePriority + descriptionScore + recencyScore
  );
}

function buildEventDescriptor_(article) {
  const title = sanitizeSingleLine_(article && article.title);
  const description = sanitizeSingleLine_(article && article.description);
  const combinedText = `${title} ${description}`;

  const canonicalTopic = detectCanonicalTopic_(combinedText);
  const type = detectEventType_(combinedText, canonicalTopic);
  const family = eventTypeFamily_(type);
  const stage = detectEventStage_(combinedText, type);
  const titleTeamKeys = detectTeamKeys_(title);
  const allTeamKeys = detectTeamKeys_(combinedText);
  const subjectTokens = extractSubjectTokens_(title, allTeamKeys);
  const topicTokens = extractTopicTokens_(combinedText);
  const factTokens = extractFactTokens_(combinedText);

  const reliableSubjectTokens = subjectTokens.slice(0, 6).sort();
  const reliableTopicTokens = topicTokens.slice(0, 8).sort();
  const primaryTeams = titleTeamKeys.length > 0
    ? titleTeamKeys.slice().sort()
    : detectLeadTeamKeys_(description).slice().sort();

  let eventKey;
  if (canonicalTopic) {
    eventKey = [
      'topic',
      canonicalTopic,
      family,
      primaryTeams.join(',') || '-'
    ].join('|');
  } else if (reliableSubjectTokens.length > 0 || primaryTeams.length > 0) {
    eventKey = [
      family,
      normalizeStageForEventKey_(stage),
      primaryTeams.join(',') || '-',
      reliableSubjectTokens.slice(0, 4).join(',') || '-',
      reliableTopicTokens.slice(0, 3).join(',') || '-'
    ].join('|');
  } else {
    eventKey = [
      'title',
      family,
      normalizeStageForEventKey_(stage),
      buildTitleFingerprint_(title).slice(0, 8).sort().join(',')
    ].join('|');
  }

  return {
    type: type,
    family: family,
    stage: stage,
    canonicalTopic: canonicalTopic,
    primaryTeamKeys: primaryTeams,
    teamKeys: allTeamKeys.slice().sort(),
    subjectTokens: reliableSubjectTokens,
    topicTokens: reliableTopicTokens,
    factTokens: factTokens,
    eventKey: eventKey,
    eventHash: generateHash(eventKey),
    titleFingerprint: buildTitleFingerprint_(title)
  };
}

function detectCanonicalTopic_(text) {
  const value = String(text || '');

  if (
    /\bNCAA\b|\bcourt ruling\b|\beligib/i.test(value) &&
    /\bsecond[- ]round(?: pick|er| selection)?s?\b/i.test(value) &&
    /\b(return|returning|college|school|unsigned|court|ruling)\b/i.test(value)
  ) {
    return 'ncaa-eligibility-unsigned-second-round-picks-return-to-college';
  }

  if (
    /\bNBA Europe\b|\bNBA European league\b|\bEuropean NBA league\b/i.test(value) &&
    /\bLondon\b/i.test(value) &&
    /\bteam\b|\bfranchise\b|\bbid\b|\bbuy\b|\binvest/i.test(value)
  ) {
    return 'nba-europe-london-franchise-investment';
  }

  if (
    /\bachilles\b/i.test(value) &&
    /\bstudy\b|\bresearch\b|\bincrease\b|\brate\b|\btrend\b/i.test(value)
  ) {
    return 'nba-achilles-injury-research-trend';
  }

  if (
    /\bcollective bargaining agreement\b|\bsecond apron\b/i.test(value) &&
    /\btrade\b/i.test(value) &&
    /\bfree agency\b/i.test(value) &&
    /\bmore\b|\bthan\b|\btrend\b|\bmovement\b/i.test(value)
  ) {
    return 'cba-offseason-player-movement-trades-vs-free-agency';
  }

  return '';
}

function detectEventType_(text, canonicalTopic) {
  const value = String(text || '');

  if (canonicalTopic === 'cba-offseason-player-movement-trades-vs-free-agency') {
    return 'trend';
  }
  if (canonicalTopic === 'nba-achilles-injury-research-trend') {
    return 'trend';
  }
  if (canonicalTopic === 'ncaa-eligibility-unsigned-second-round-picks-return-to-college') {
    return 'policy';
  }
  if (canonicalTopic === 'nba-europe-london-franchise-investment') {
    return 'ownership';
  }

  const rules = [
    ['policy', /\beligibility rule\b|\bnew rule\b|\bleague rule\b|\bpolicy change\b|\bNCAA ruling\b/i],
    ['trend', /\bstudy finds\b|\bresearch shows\b|\btrend\b|\bleaguewide increase\b|\bmore players\b.*\bthan\b/i],
    ['extension', /\bre-?sign(?:s|ed|ing)?\b|\bcontract extension\b|\bextension\b|\bextended\b/i],
    ['trade_rumor', /\btrade rumor\b|\btrade target\b|\binterested in\b|\blinked to\b|\bexploring\b.*\btrade\b|\bcould be traded\b/i],
    ['trade', /\btraded?\b|\bacquire(?:s|d)?\b|\bdeal sends\b|\btrade sends\b|\bthree-team trade\b/i],
    ['waiver', /\bwaive(?:s|d)?\b|\brelease(?:s|d)?\b|\broster cut\b|\bcut ties\b/i],
    ['injury', /\binjur(?:y|ed)\b|\bsurgery\b|\bout for\b|\bdiagnos(?:is|ed)\b|\btorn\b|\bsprain\b/i],
    ['return', /\bcleared to play\b|\breturn(?:s|ed|ing)?\b|\bback in the lineup\b/i],
    ['suspension', /\bsuspend(?:s|ed|ing|sion)?\b|\bbanned\b/i],
    ['coach', /\bNBA head coach\b|\bcoach(?:ing)? hire\b|\bfires? coach\b|\bNBA coaching staff\b/i],
    ['executive', /\bgeneral manager\b|\bpresident of basketball\b|\bfront office\b|\bexecutive\b/i],
    ['draft', /\bNBA draft\b|\bfirst-round pick\b|\bsecond-round pick\b|\bdraft prospect\b/i],
    ['investigation', /\binvestigat(?:e|es|ed|ion)\b|\bprobe\b/i],
    ['legal', /\blawsuit\b|\bcriminal court\b|\bcharges?\b|\bindict(?:ed|ment)?\b|\blegal action\b/i],
    ['arena', /\barena\b|\bstadium\b|\brenovation\b|\bpublic funding\b/i],
    ['ownership', /\bownership\b|\bteam sale\b|\bfranchise sale\b|\brelocat(?:e|ion)\b|\bmove the team\b/i],
    ['retirement', /\bretire(?:s|d|ment)?\b/i],
    ['game', /\bdefeat(?:s|ed)?\b|\bbeats?\b|\bwins?\b|\bloses?\b|\bfinal score\b/i],
    ['signing', /\bsign(?:s|ed|ing)?\b|\bagree(?:s|d)? to (?:a |an )?(?:contract|deal|two-way)\b|\bjoins? the\b.*\bteam\b/i],
    ['comment', /\bsays?\b|\bsaid\b|\bcomments?\b|\bbelieves?\b|\bcompares?\b|\bpraises?\b|\bcriticizes?\b/i]
  ];

  for (let i = 0; i < rules.length; i++) {
    if (rules[i][1].test(value)) return rules[i][0];
  }

  return 'general';
}

function eventTypeFamily_(type) {
  if (type === 'extension' || type === 'signing') return 'contract';
  if (type === 'trade' || type === 'trade_rumor') return 'trade';
  if (type === 'injury' || type === 'return') return 'health';
  if (type === 'investigation' || type === 'legal') return 'legal';
  if (type === 'arena' || type === 'ownership') return 'business';
  if (type === 'policy') return 'policy';
  if (type === 'trend') return 'analysis';
  return type || 'general';
}

function detectEventStage_(text, type) {
  const value = String(text || '');

  if (type === 'trend' || type === 'policy') return 'reported';

  if (/\bofficially\b|\bofficial announcement\b|\bannounces?\b|\bteam announced\b/i.test(value)) {
    return 'official';
  }

  if (
    /\bre-?sign(?:s|ed)?\b|\bsign(?:s|ed)?\b|\btraded?\b|\bwaive(?:s|d)?\b|\brelease(?:s|d)?\b|\bhired?\b|\bfired?\b|\bcontract extension\b/i.test(value)
  ) {
    return 'completed';
  }

  if (/\bagree(?:s|d)? to (?:a |an )?(?:contract|deal|trade)\b|\bfinalizing\b|\breached an agreement\b/i.test(value)) {
    return 'agreement';
  }

  if (
    type === 'trade_rumor' ||
    /\brumor\b|\binterested in\b|\bconsidering\b|\bexpected to\b|\bcould\b|\bmay\b|\bmight\b|\bexploring\b|\bin discussions\b/i.test(value)
  ) {
    return 'rumor';
  }

  return 'reported';
}

function normalizeStageForEventKey_(stage) {
  if (stage === 'official' || stage === 'completed' || stage === 'agreement') {
    return 'advanced';
  }
  return stage || 'reported';
}

function eventStageRank_(stage) {
  const ranks = { rumor: 1, reported: 2, agreement: 3, completed: 4, official: 5 };
  return ranks[stage] || 0;
}

function detectTeamKeys_(text) {
  const normalized = String(text || '');
  const result = [];

  Object.keys(NBA_TEAM_ALIASES).forEach(function (teamKey) {
    const matched = NBA_TEAM_ALIASES[teamKey].some(function (alias) {
      const pattern = new RegExp(
        '(^|[^a-z0-9])' + escapeRegExp_(alias.toLowerCase()) + '([^a-z0-9]|$)',
        'i'
      );
      return pattern.test(normalized.toLowerCase());
    });
    if (matched) result.push(teamKey);
  });

  return result;
}

function detectLeadTeamKeys_(description) {
  return detectTeamKeys_(firstSentence_(description));
}

function extractSubjectTokens_(title, teamKeys) {
  let cleaned = String(title || '').toLowerCase();

  (teamKeys || []).forEach(function (teamKey) {
    (NBA_TEAM_ALIASES[teamKey] || [])
      .slice()
      .sort(function (a, b) { return b.length - a.length; })
      .forEach(function (alias) {
        const pattern = new RegExp(
          '(^|[^a-z0-9])' + escapeRegExp_(alias.toLowerCase()) + '([^a-z0-9]|$)',
          'gi'
        );
        cleaned = cleaned.replace(pattern, ' ');
      });
  });

  return cleaned
    .replace(/\$[\d.,]+/g, ' ')
    .replace(/\b\d+(?:\.\d+)?\b/g, ' ')
    .replace(/[^a-z]+/g, ' ')
    .trim()
    .split(/\s+/)
    .filter(function (token) {
      return token.length >= 2 && token.length <= 24 && !EVENT_TOKEN_STOP_WORDS.has(token);
    })
    .slice(0, 10);
}

function extractTopicTokens_(text) {
  const value = String(text || '').toLowerCase();
  const dictionary = [
    'ncaa', 'eligibility', 'second-round', 'unsigned', 'college', 'return',
    'achilles', 'injury', 'study', 'research', 'trade', 'free agency',
    'salary cap', 'second apron', 'collective bargaining agreement',
    'ownership', 'arena', 'relocation', 'nba europe', 'london', 'draft',
    'suspension', 'investigation', 'lawsuit', 'contract', 'two-way',
    'player option', 'team option', 'qualifying offer'
  ];
  const result = [];

  dictionary.forEach(function (term) {
    if (value.indexOf(term) !== -1) result.push(term.replace(/\s+/g, '-'));
  });

  return Array.from(new Set(result));
}

function extractFactTokens_(text) {
  const value = String(text || '');
  const facts = [];

  collectMoneyFactsFromText_(value).forEach(function (amount) {
    facts.push('money:' + roundMoney_(amount));
  });

  const durationPatterns = [
    /\b(\d+)\s*[- ]?year\b/gi,
    /\b(\d+)\s*[- ]?month\b/gi,
    /\b(\d+)\s*[- ]?week\b/gi,
    /\b(\d+)\s*[- ]?day\b/gi
  ];

  durationPatterns.forEach(function (pattern) {
    let match;
    while ((match = pattern.exec(value)) !== null) {
      facts.push(match[0].toLowerCase().replace(/\s+/g, ''));
    }
  });

  if (/\bsurgery\b/i.test(value)) facts.push('medical:surgery');
  if (/\bseason-ending\b/i.test(value)) facts.push('medical:season-ending');
  if (/\bfully guaranteed\b/i.test(value)) facts.push('contract:fully-guaranteed');
  if (/\bteam option\b/i.test(value)) facts.push('contract:team-option');
  if (/\bplayer option\b/i.test(value)) facts.push('contract:player-option');
  if (/\btwo-way contract\b/i.test(value)) facts.push('contract:two-way');
  if (/\b10-day contract\b/i.test(value)) facts.push('contract:10-day');

  return Array.from(new Set(facts)).sort();
}

function areEventDescriptorsSame_(a, b) {
  if (!a || !b) return false;
  if (a.eventHash === b.eventHash) return true;

  if (a.canonicalTopic && b.canonicalTopic && a.canonicalTopic === b.canonicalTopic) {
    return true;
  }

  if (a.family !== b.family) return false;

  const primaryTeamsOverlap = setIntersectionCount_(a.primaryTeamKeys, b.primaryTeamKeys);
  const allTeamsOverlap = setIntersectionCount_(a.teamKeys, b.teamKeys);
  const sharedSubjects = setIntersectionCount_(a.subjectTokens, b.subjectTokens);
  const sharedTopics = setIntersectionCount_(a.topicTokens, b.topicTokens);
  const minSubjectSize = Math.min(a.subjectTokens.length, b.subjectTokens.length);
  const overlapCoefficient = minSubjectSize > 0 ? sharedSubjects / minSubjectSize : 0;

  if (
    a.primaryTeamKeys.length > 0 && b.primaryTeamKeys.length > 0 &&
    primaryTeamsOverlap === 0
  ) {
    return false;
  }

  if (primaryTeamsOverlap > 0 && sharedSubjects >= 1) return true;
  if (allTeamsOverlap > 0 && sharedSubjects >= 2) return true;

  if (
    allTeamsOverlap > 0 && sharedSubjects >= 1 && overlapCoefficient >= 0.5 &&
    longestSharedTokenLength_(a.subjectTokens, b.subjectTokens) >= 6
  ) {
    return true;
  }

  if (
    (a.family === 'policy' || a.family === 'analysis') &&
    sharedTopics >= 2 && sharedSubjects >= 1
  ) {
    return true;
  }

  if (allTeamsOverlap === 0 && sharedSubjects >= 2 && overlapCoefficient >= 0.66) {
    return true;
  }

  return areTitleFingerprintsSimilar_(a.titleFingerprint, b.titleFingerprint);
}

function findRecentDuplicateEvent_(article, eventMemory, recentEventHashSet) {
  const descriptor = article.eventDescriptor || buildEventDescriptor_(article);

  if (recentEventHashSet.has(descriptor.eventHash)) {
    return {
      isDuplicate: true,
      reason: `最近 ${CONFIG.EVENT_DEDUPE_WINDOW_HOURS} 小时文件名中已有相同事件哈希`,
      matchedTitle: ''
    };
  }

  const cutoff =
    new Date().getTime() - CONFIG.EVENT_DEDUPE_WINDOW_HOURS * 60 * 60 * 1000;

  for (let i = 0; i < (eventMemory || []).length; i++) {
    const memoryItem = eventMemory[i];
    if (!memoryItem || Number(memoryItem.timestamp) < cutoff) continue;

    const rememberedDescriptor = {
      family: memoryItem.family || 'general',
      stage: memoryItem.stage || 'reported',
      canonicalTopic: memoryItem.canonicalTopic || '',
      primaryTeamKeys: memoryItem.primaryTeamKeys || memoryItem.teamKeys || [],
      teamKeys: memoryItem.teamKeys || [],
      subjectTokens: memoryItem.subjectTokens || [],
      topicTokens: memoryItem.topicTokens || [],
      factTokens: memoryItem.factTokens || [],
      eventHash: memoryItem.eventHash || '',
      titleFingerprint: memoryItem.titleFingerprint || []
    };

    // 兼容旧版本事件记忆：用旧稿标题按本版规则重新生成一次事件指纹。
    const rebuiltDescriptor = buildEventDescriptor_({
      title: [memoryItem.sourceTitle || '', memoryItem.publishedTitle || ''].join(' '),
      description: '',
      source: 'event-memory',
      link: ''
    });
    const matchedDescriptor = areEventDescriptorsSame_(descriptor, rememberedDescriptor)
      ? rememberedDescriptor
      : (areEventDescriptorsSame_(descriptor, rebuiltDescriptor) ? rebuiltDescriptor : null);

    if (!matchedDescriptor) continue;

    if (hasMaterialProgression_(descriptor, matchedDescriptor, article)) {
      return {
        isDuplicate: false,
        reason: '同一事件出现可识别的实质新进展',
        matchedTitle: memoryItem.publishedTitle || memoryItem.sourceTitle || ''
      };
    }

    return {
      isDuplicate: true,
      reason: '与最近已发布事件属于同一核心事件，新增人物或扩展名单不构成新进展：' +
        (memoryItem.publishedTitle || memoryItem.sourceTitle || memoryItem.eventHash),
      matchedTitle: memoryItem.publishedTitle || memoryItem.sourceTitle || ''
    };
  }

  return { isDuplicate: false, reason: '', matchedTitle: '' };
}

function hasMaterialProgression_(candidate, previous, article) {
  if (
    candidate.canonicalTopic && previous.canonicalTopic &&
    candidate.canonicalTopic === previous.canonicalTopic
  ) {
    // NCAA 单人稿扩展成多人名单、研究文章增加更多样本，不视为实质新事件。
    if (
      candidate.canonicalTopic === 'ncaa-eligibility-unsigned-second-round-picks-return-to-college' ||
      candidate.canonicalTopic === 'nba-achilles-injury-research-trend'
    ) {
      return false;
    }
  }

  if (eventStageRank_(candidate.stage) > eventStageRank_(previous.stage)) return true;

  const combinedText = getArticleContentText_(article);
  if (/\bcorrection\b|\bcorrected\b|\bupdated terms\b|\brevised\b/i.test(combinedText)) {
    return true;
  }

  const candidateFacts = candidate.factTokens || [];
  const previousFacts = previous.factTokens || [];

  const newlyAddedFacts = candidateFacts.filter(function (item) {
    return previousFacts.indexOf(item) === -1;
  });

  if (
    candidate.family === 'health' &&
    newlyAddedFacts.some(function (item) { return item.indexOf('medical:') === 0; })
  ) {
    return true;
  }

  const candidateHasMoney = candidateFacts.some(function (item) {
    return item.indexOf('money:') === 0;
  });
  const previousHasMoney = previousFacts.some(function (item) {
    return item.indexOf('money:') === 0;
  });
  if (candidateHasMoney && !previousHasMoney) return true;

  const candidateHasDuration = candidateFacts.some(function (item) {
    return /year|month|week|day/.test(item);
  });
  const previousHasDuration = previousFacts.some(function (item) {
    return /year|month|week|day/.test(item);
  });
  if (candidateHasDuration && !previousHasDuration) return true;

  return false;
}

function buildTitleFingerprint_(title) {
  return String(title || '')
    .toLowerCase()
    .replace(/\$[\d.,]+/g, ' ')
    .replace(/\b\d+(?:\.\d+)?\b/g, ' ')
    .replace(/[^a-z]+/g, ' ')
    .trim()
    .split(/\s+/)
    .filter(function (token) {
      return token.length > 1 && !EVENT_TOKEN_STOP_WORDS.has(token);
    });
}

function areTitleFingerprintsSimilar_(a, b) {
  if (!a || !b || !a.length || !b.length) return false;
  const shared = setIntersectionCount_(a, b);
  const union = new Set(a.concat(b)).size;
  const minSize = Math.min(new Set(a).size, new Set(b).size);

  return (
    shared >= 3 &&
    ((union > 0 && shared / union >= 0.5) ||
     (minSize > 0 && shared / minSize >= 0.66))
  );
}

function longestSharedTokenLength_(a, b) {
  const setB = new Set(b || []);
  let longest = 0;
  (a || []).forEach(function (token) {
    if (setB.has(token)) longest = Math.max(longest, token.length);
  });
  return longest;
}

function setIntersectionCount_(a, b) {
  const setB = new Set(b || []);
  let count = 0;
  new Set(a || []).forEach(function (item) {
    if (setB.has(item)) count++;
  });
  return count;
}

// ============================================================================
// 发布前代码预过滤
// ============================================================================

function prefilterArticleBeforeGemini_(article) {
  const contentText = getArticleContentText_(article);
  const titleText = getArticleReports_(article).map(function (report) {
    return report.title || '';
  }).join(' ');

  const explicitOtherLeague = HARD_OTHER_LEAGUE_PATTERNS.find(function (pattern) {
    return pattern.test(contentText);
  });

  // WNBA 标题或以 WNBA 为核心的素材直接拒绝；若只是 NBA 正文中的对比背景，不误杀。
  const hasWnbaSignal = /\bWNBA\b|Women(?:'s)? National Basketball Association/i.test(contentText);
  const wnbaIsHeadlineSubject = /\bWNBA\b|Women(?:'s)? National Basketball Association|women(?:'s)? basketball expansion team/i.test(titleText);
  const hasStrongNbaPrimarySignal = /\bNBA\b|National Basketball Association/i.test(titleText) || detectTeamKeys_(titleText).length > 0;
  if (hasWnbaSignal && (wnbaIsHeadlineSubject || !hasStrongNbaPrimarySignal)) {
    return {
      pass: false,
      stage: '非 NBA 内容',
      reason: '素材核心属于 WNBA，不属于 NBA 新闻',
      suspectedFalsePositive: false
    };
  }

  if (explicitOtherLeague && !hasDirectNbaSubjectSignal_(contentText)) {
    return {
      pass: false,
      stage: '非 NBA 内容',
      reason: '素材核心属于其他体育联盟，且没有直接 NBA 主体或影响',
      suspectedFalsePositive: false
    };
  }

  const privateLifePattern = PRIVATE_LIFE_PATTERNS.find(function (pattern) {
    return pattern.test(contentText);
  });
  const hasBasketballImpact = BASKETBALL_IMPACT_PATTERNS.some(function (pattern) {
    return pattern.test(contentText);
  });

  if (privateLifePattern && !hasBasketballImpact) {
    return {
      pass: false,
      stage: '私人生活与花边内容',
      reason: '核心是恋情、婚姻、抚养或家庭纠纷，未直接影响比赛、合同、纪律或球队运营',
      suspectedFalsePositive: false
    };
  }

  const lowValuePattern = LOW_VALUE_CONTENT_PATTERNS.find(function (pattern) {
    return pattern.test(contentText);
  });
  if (lowValuePattern) {
    return {
      pass: false,
      stage: '新闻价值不足',
      reason: '明确属于博彩、链接汇总、社交媒体琐事、日常生活或其他低价值内容',
      suspectedFalsePositive: false
    };
  }

  const pureGLeagueStaff = PURE_G_LEAGUE_STAFF_PATTERNS.some(function (pattern) {
    return pattern.test(contentText);
  });
  if (pureGLeagueStaff && !/\bNBA coaching staff\b|\bNBA assistant coach\b/i.test(contentText)) {
    return {
      pass: false,
      stage: '新闻价值不足',
      reason: '纯 G League 教练任命，未体现对 NBA 球队或联盟的直接影响',
      suspectedFalsePositive: false
    };
  }

  if (
    /\bNCAA\b/i.test(contentText) &&
    !/\bNBA draft\b|\bNBA team\b|\bfirst-round pick\b|\bsecond-round pick\b/i.test(contentText) &&
    detectTeamKeys_(contentText).length === 0
  ) {
    return {
      pass: false,
      stage: '非 NBA 内容',
      reason: '纯 NCAA 内容，没有明确 NBA 选秀、球队或球员关联',
      suspectedFalsePositive: false
    };
  }

  const hasNamedCore = hasNamedCoreSubject_(article);
  if (
    /\bmystery team\b|\bunnamed team\b|\bnew western conference rival\b|\bnew suitor\b/i.test(titleText) &&
    !hasNamedCore
  ) {
    return {
      pass: false,
      stage: '信息不完整或可信度不足',
      reason: '标题依赖未具名球队或对象，素材没有给出可确认的核心主体',
      suspectedFalsePositive: true
    };
  }

  // NBA 专用 RSS 偶尔会省略“NBA”或球队全名。除非命中上面的明确硬边界，
  // 其余模糊稿件交给 Gemini 总编判断，避免把过滤器调得过严。
  return { pass: true, stage: '', reason: '', suspectedFalsePositive: false };
}

function hasDirectNbaSubjectSignal_(text) {
  const value = String(text || '');
  const hasDirectPattern = DIRECT_NBA_PATTERNS.some(function (pattern) {
    return pattern.test(value);
  });
  return hasDirectPattern || detectTeamKeys_(value).length > 0;
}

function hasNamedCoreSubject_(article) {
  const text = getArticleContentText_(article);
  if (detectTeamKeys_(text).length > 0) return true;
  if (/\b[A-Z][a-z]+(?:[-'][A-Z]?[a-z]+)?\s+[A-Z][a-z]+(?:[-'][A-Z]?[a-z]+)?\b/.test(text)) {
    return true;
  }
  return false;
}

