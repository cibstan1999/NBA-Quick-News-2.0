function rememberPublishedEvent_(memory, article, publishedTitle) {
  const descriptor = article.eventDescriptor;
  const item = {
    timestamp: new Date().getTime(),
    eventHash: descriptor.eventHash,
    family: descriptor.family,
    stage: descriptor.stage,
    teamKeys: descriptor.teamKeys.slice(0, 3),
    subjectTokens: descriptor.subjectTokens.slice(0, 4),
    factTokens: descriptor.factTokens.slice(0, 6),
    titleFingerprint: descriptor.titleFingerprint.slice(0, 8),
    sourceTitle: truncateText_(article.title, 120),
    publishedTitle: truncateText_(publishedTitle, 80)
  };
  memory.unshift(item);
  const seen = new Set();
  const trimmed = memory.filter(function (entry) {
    const key = String(entry.eventHash || '') + '|' + String(entry.sourceTitle || '');
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  }).slice(0, CONFIG.EVENT_MEMORY_MAX_ITEMS);
  memory.length = 0;
  Array.prototype.push.apply(memory, trimmed);
  savePublishedEventMemory_(memory);
}

function savePublishedEventMemory_(memory) {
  const props = PropertiesService.getScriptProperties();
  let trimmed = (memory || []).slice(0, CONFIG.EVENT_MEMORY_MAX_ITEMS);
  try {
    props.setProperty(CONFIG.EVENT_MEMORY_PROPERTY, JSON.stringify(trimmed));
