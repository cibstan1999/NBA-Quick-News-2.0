function recordRejection_(run, article, stage, reason, options) {
  const opts = options || {};
  const reports = getArticleReports_(article);
  const descriptor = article && article.eventDescriptor
    ? article.eventDescriptor
    : buildEventDescriptor_(article || {});

  reports.forEach(function (report, index) {
    run.rejections.push({
      recordedAt: new Date().getTime(),
      source: sanitizeSingleLine_(report.source || article.source),
      title: sanitizeSingleLine_(report.title || article.title),
      url: String(report.link || article.link || '').trim(),
      publishedAt: formatArticleDateForPrompt_(report.publishedAt || article.publishedAt),
      stage: sanitizeSingleLine_(stage),
      reason: sanitizeSingleLine_(reason),
      geminiReason: sanitizeSingleLine_(opts.geminiReason || ''),
      duplicateOf: sanitizeSingleLine_(opts.duplicateOf || ''),
      eventKey: descriptor.eventKey || '',
      eventHash: descriptor.eventHash || '',
      eventType: `${descriptor.family || 'general'}/${descriptor.stage || 'reported'}`,
      canonicalTopic: descriptor.canonicalTopic || '',
      suspectedFalsePositive: Boolean(opts.suspectedFalsePositive),
      groupIndex: index + 1,
      groupSize: reports.length
    });
  });
}

function commitRejectionArchiveToGithub_(run, env) {
  if (!run || !Array.isArray(run.rejections) || run.rejections.length === 0) {
    return { ok: true, filePath: '', error: '' };
  }

  const now = new Date();
  const dateString = Utilities.formatDate(now, CONFIG.TIMEZONE, 'yyyy-MM-dd');
  const monthString = Utilities.formatDate(now, CONFIG.TIMEZONE, 'yyyy-MM');
  const timeString = Utilities.formatDate(now, CONFIG.TIMEZONE, 'HHmmss');
  const filePath =
    `${CONFIG.REJECTION_ARCHIVE_DIR}/${monthString}/` +
    `${dateString}-${timeString}-${run.runId}.md`;
  const content = buildRejectionArchiveMarkdown_(run);

  const result = putNewGithubFile_(
    filePath,
    content,
    `🗃️ [Auto-Rejection] 保存退稿档案 ${run.runId}（${run.rejections.length} 条）`,
    env
  );

  if (result.ok) {
    Logger.log(`🗃️ 退稿档案已保存：${filePath}`);
  }

  return result;
}

function buildRejectionArchiveMarkdown_(run) {
  const generatedAt = Utilities.formatDate(
    new Date(),
    CONFIG.TIMEZONE,
    'yyyy-MM-dd HH:mm:ss'
  );
  const lines = [
    '---',
    `run_id: ${yamlQuote_(run.runId)}`,
    `generated_at: ${yamlQuote_(generatedAt + ' +0800')}`,
    `rejection_count: ${run.rejections.length}`,
    '---',
    '',
    `# NBA-Quick-News 退稿档案 · ${run.runId}`,
    '',
    `- 运行时间：${generatedAt}（北京时间）`,
    `- 退稿数量：${run.rejections.length}`,
    `- 成功发布：${run.metrics.published}`,
    `- Gemini 调用：${run.metrics.geminiAttempted}`,
    '',
    '> 本档案由 GAS 自动生成。写入失败不会阻塞新闻发布。',
    ''
  ];

  run.rejections.forEach(function (item, index) {
    lines.push(`## ${index + 1}. ${escapeMarkdownText_(item.title || '未命名稿件')}`);
    lines.push('');
    lines.push(`- **来源**：${escapeMarkdownText_(item.source || '-')}`);
    lines.push(`- **原文标题**：${escapeMarkdownText_(item.title || '-')}`);
    lines.push(`- **原文 URL**：${item.url || '-'}`);
    lines.push(`- **RSS 时间**：${escapeMarkdownText_(item.publishedAt || '-')}`);
    lines.push(`- **拒绝阶段**：${escapeMarkdownText_(item.stage || '-')}`);
    lines.push(`- **拒绝原因**：${escapeMarkdownText_(item.reason || '-')}`);
    lines.push(`- **事件类型**：${escapeMarkdownText_(item.eventType || '-')}`);
    lines.push(`- **事件键**：\`${escapeBackticks_(item.eventKey || '-')}\``);
    lines.push(`- **事件哈希**：\`${escapeBackticks_(item.eventHash || '-')}\``);
    lines.push(`- **规范主题**：${escapeMarkdownText_(item.canonicalTopic || '-')}`);
    lines.push(`- **同组素材**：${item.groupIndex}/${item.groupSize}`);

    if (item.duplicateOf) {
      lines.push(`- **重复对象**：${escapeMarkdownText_(item.duplicateOf)}`);
    }
    if (item.geminiReason) {
      lines.push(`- **Gemini 原始判断**：${escapeMarkdownText_(item.geminiReason)}`);
    }

    lines.push(`- **疑似误杀，需人工复查**：${item.suspectedFalsePositive ? '是' : '否'}`);
    lines.push('');
  });

  return lines.join('\n');
}

function shouldFlagPossibleFalsePositive_(reason) {
  const value = String(reason || '');
  return /信息不足|无法确认|格式|重复|边界|低价值/i.test(value);
}

function escapeMarkdownText_(value) {
  return sanitizeSingleLine_(value).replace(/([*_\[\]<>])/g, '\\$1');
}

function escapeBackticks_(value) {
  return String(value || '').replace(/`/g, '\\`');
}

