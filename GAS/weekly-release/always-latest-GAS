}

function parseGeminiEditorialResponse_(responseText) {
  try {
    const payload = JSON.parse(responseText);
    if (!payload.candidates || payload.candidates.length === 0) {
      const blockReason = payload.promptFeedback && payload.promptFeedback.blockReason
        ? payload.promptFeedback.blockReason
        : '未知原因';
      return {
        ok: false,
        data: null,
        error: `Gemini没有返回候选内容，blockReason=${blockReason}`
      };
    }
    const candidate = payload.candidates[0];
    if (!candidate.content || !Array.isArray(candidate.content.parts)) {
      return {
        ok: false,
        data: null,
        error: 'Gemini候选内容为空，finishReason=' + String(candidate.finishReason || 'UNKNOWN')
      };
    }
    const text = candidate.content.parts
      .filter(function (part) { return part && typeof part.text === 'string'; })
      .map(function (part) { return part.text; })
      .join('')
      .trim();
    if (!text) return { ok: false, data: null, error: 'Gemini返回了空文本' };
    const cleanedText = text
      .replace(/^\s*```json\s*/i, '')
      .replace(/^\s*```\s*/i, '')
      .replace(/\s*```\s*$/i, '')
      .trim();
    return { ok: true, data: JSON.parse(cleanedText), error: '' };
  } catch (error) {
    return {
      ok: false,
      data: null,
      error: 'Gemini结构化响应解析失败：' + formatError_(error)
    };
  }
}

function validateEditorialResult_(rawData, fullTeamMap, article) {
  if (!rawData || typeof rawData !== 'object') {
    return { ok: false, data: null, warnings: [], error: '返回结果不是有效对象' };
  }
  const isPass = rawData.isPass === true;
  const reason = sanitizeSingleLine_(rawData.reason);
  if (!isPass) {
    return {
      ok: true,
      data: {
        isPass: false,
        reason: reason || 'REJECT-Gemini总编拒绝发布',
        title: '',
        summary: '',
        highlights: [],
        bodyText: '',
        tags: []
      },
      warnings: [],
      error: ''
    };
  }
  let editorial = {
    isPass: true,
    reason: reason,
    title: sanitizeSingleLine_(rawData.title),
    summary: sanitizeSingleLine_(rawData.summary),
    highlights: Array.isArray(rawData.highlights)
      ? rawData.highlights.map(sanitizeSingleLine_).filter(function (item) {
          return item.length > 0;
        }).slice(0, 4)
      : [],
    bodyText: normalizeBodyText_(rawData.bodyText),
    tags: rawData.tags
  };
  const moneyResult = repairAndValidateMoneyFacts_(editorial, article);
  if (!moneyResult.ok) {
    return {
      ok: false,
      data: null,
      warnings: moneyResult.warnings,
      error: moneyResult.error
    };
  }
  editorial = moneyResult.data;
  const warnings = moneyResult.warnings.slice();
  const tagResult = normalizeAndRepairTags_(
    editorial.tags,
    fullTeamMap,
    article,
    [editorial.title, editorial.summary, editorial.bodyText].join(' ')
  );
  editorial.tags = tagResult.tags;
  Array.prototype.push.apply(warnings, tagResult.warnings);
  if (!editorial.reason) return { ok: false, data: null, warnings: warnings, error: '通过结果缺少reason' };
  if (!editorial.title) return { ok: false, data: null, warnings: warnings, error: '通过结果缺少标题' };
  if (editorial.title.length > 60) return { ok: false, data: null, warnings: warnings, error: '标题长度异常' };
  if (!editorial.summary) return { ok: false, data: null, warnings: warnings, error: '通过结果缺少一句话速览' };
  if (editorial.summary.length > 220) return { ok: false, data: null, warnings: warnings, error: '一句话速览长度异常' };
  if (editorial.highlights.length < 1 || editorial.highlights.length > 4) {
    return {
      ok: false,
      data: null,
      warnings: warnings,
      error: `核心细节必须为1至4条，实际为${editorial.highlights.length}条`
    };
  }
  if (!editorial.bodyText || editorial.bodyText.length < 50) {
    return { ok: false, data: null, warnings: warnings, error: '正文为空或信息不足，拒绝提交' };
  }
  if (editorial.tags.length === 0) {
    editorial.tags.push(FALLBACK_EVENT_TAG);
    warnings.push(`未找到可靠具体标签，代码仅在本篇使用兜底标签“${FALLBACK_EVENT_TAG}”。`);
  }
  return {
    ok: true,
    data: {
      isPass: true,
      reason: editorial.reason,
      title: editorial.title,
      summary: editorial.summary,
      highlights: editorial.highlights,
      bodyText: editorial.bodyText,
      tags: editorial.tags.slice(0, 4)
    },
    warnings: warnings,
    error: ''
  };
}

function repairAndValidateMoneyFacts_(editorial, article) {
  const sourceFacts = (article.moneyFacts || []).slice();
  const warnings = [];
  const data = {
    isPass: editorial.isPass,
    reason: editorial.reason,
    title: editorial.title,
    summary: editorial.summary,
    highlights: editorial.highlights.slice(),
    bodyText: editorial.bodyText,
    tags: editorial.tags
  };
  if (sourceFacts.length === 0) {
    return { ok: true, data: data, warnings: warnings, error: '' };
  }
  if (article.moneyConflict) {
    const outputText = [
      data.title,
      data.summary,
      data.highlights.join(' '),
      data.bodyText
    ].join(' ');
    const outputFacts = collectChineseMoneyFacts_(outputText);
    const hasConflictLanguage = /差异|不一致|不同报道|分别|两个版本|多种说法/i.test(outputText);
    const coversEverySourceAmount = sourceFacts.every(function (sourceAmount) {
      return outputFacts.some(function (outputAmount) {
        return moneyAmountsClose_(sourceAmount, outputAmount);
      });
    });
    if (outputFacts.length > 0 && (!hasConflictLanguage || !coversEverySourceAmount)) {
      return {
        ok: false,
        data: null,
        warnings: warnings,
        error: '同事件来源金额冲突，但成品写成了单一或不完整的确定金额；为避免发布错误数字，本篇停止提交'
      };
    }
    if (outputFacts.length === 0) {
      warnings.push('来源金额存在冲突，Gemini已省略具体金额，符合安全规则。');
    }
    return { ok: true, data: data, warnings: warnings, error: '' };
  }
  const expectedMillions = sourceFacts[0];
  data.title = repairMillionUnitMistake_(data.title, expectedMillions);
  data.summary = repairMillionUnitMistake_(data.summary, expectedMillions);
  data.highlights = data.highlights.map(function (item) {
    return repairMillionUnitMistake_(item, expectedMillions);
  });
  data.bodyText = repairMillionUnitMistake_(data.bodyText, expectedMillions);
  const outputText = [
    data.title,
    data.summary,
    data.highlights.join(' '),
    data.bodyText
  ].join(' ');
  const outputFacts = collectChineseMoneyFacts_(outputText);
  if (
    outputFacts.length > 0 &&
    !outputFacts.some(function (amount) { return moneyAmountsClose_(amount, expectedMillions); })
  ) {
    return {
      ok: false,
      data: null,
      warnings: warnings,
      error: '成品中的美元金额与输入来源不一致；为避免数字翻译错误，本篇停止提交'
    };
  }
  const originalText = [
    editorial.title,
    editorial.summary,
    editorial.highlights.join(' '),
    editorial.bodyText
  ].join(' ');
  if (originalText !== outputText) {
    warnings.push(
      `代码已修复美元million单位错误，标准金额为${formatUsdMillionsForLog_(expectedMillions)}。`
    );
  }
  return { ok: true, data: data, warnings: warnings, error: '' };
}

function repairMillionUnitMistake_(text, expectedMillions) {
  let result = String(text || '');
  const sourceNumber = trimTrailingZeros_(expectedMillions);
  const expectedWan = trimTrailingZeros_(expectedMillions * 100);
  const wrongPattern = new RegExp(
    '(^|[^0-9])' + escapeRegExp_(sourceNumber) + '\\s*万\\s*美(?:元|金)',
    'g'
  );
  result = result.replace(wrongPattern, function (match, prefix) {
    return prefix + expectedWan + '万美元';
  });
  return result;
}

function collectMoneyFactsFromReports_(reports) {
  const values = [];
  (reports || []).forEach(function (report) {
    collectMoneyFactsFromText_(`${report.title || ''} ${report.description || ''}`)
      .forEach(function (amount) {
        if (!values.some(function (existing) { return moneyAmountsClose_(existing, amount); })) {
          values.push(amount);
        }
      });
  });
  return values.sort(function (a, b) { return a - b; });
}

function collectMoneyFactsFromText_(text) {
  const value = String(text || '');
  const result = [];
  const pattern = /\$(\d+(?:\.\d+)?)\s*(billion|million|bn|m|b)\b/gi;
  let match;
  while ((match = pattern.exec(value)) !== null) {
    const number = Number(match[1]);
    const unit = String(match[2] || '').toLowerCase();
    if (!isFinite(number)) continue;
    let millions = number;
    if (unit === 'billion' || unit === 'bn' || unit === 'b') millions = number * 1000;
    result.push(roundMoney_(millions));
  }
  return result;
}

function collectChineseMoneyFacts_(text) {
  const value = String(text || '');
  const result = [];
  const pattern = /(\d+(?:\.\d+)?)\s*(亿|万)?\s*美(?:元|金)/g;
  let match;
  while ((match = pattern.exec(value)) !== null) {
    const number = Number(match[1]);
    const unit = match[2] || '';
    if (!isFinite(number)) continue;
    let millions;
    if (unit === '亿') millions = number * 100;
    else if (unit === '万') millions = number / 100;
    else millions = number / 1000000;
    result.push(roundMoney_(millions));
  }
  return result;
}

function hasMoneyConflict_(facts) {
  if (!facts || facts.length < 2) return false;
  const min = Math.min.apply(null, facts);
  const max = Math.max.apply(null, facts);
  return Math.abs(max - min) >= 0.05;
}

function moneyAmountsClose_(a, b) {
  return Math.abs(Number(a) - Number(b)) < 0.02;
}

function roundMoney_(value) {
  return Math.round(Number(value) * 1000) / 1000;
}

function formatUsdMillionsForLog_(millions) {
  if (millions >= 1000) {
    return '$' + trimTrailingZeros_(millions / 1000) + ' billion';
  }
  return '$' + trimTrailingZeros_(millions) + ' million';
}

function trimTrailingZeros_(value) {
  return String(Math.round(Number(value) * 1000) / 1000).replace(/\.0+$/, '');
}

function normalizeAndRepairTags_(rawTags, fullTeamMap, article, editorialText) {
  const allowedTeamTags = buildAllowedTeamTagSet_(fullTeamMap);
  const allowedEventTags = new Set(ALLOWED_EVENT_TAGS);
  const uniqueTags = [];
  const warnings = [];
  const combinedText = [getArticleText_(article), editorialText].join(' ');
  (Array.isArray(rawTags) ? rawTags : []).forEach(function (rawTag) {
    const tag = sanitizeSingleLine_(rawTag).replace(/^#/, '').trim();
    if (!tag) return;
    const isAllowed =
      allowedTeamTags.has(tag) ||
      allowedEventTags.has(tag) ||
      isSupportedSubjectTag_(tag, combinedText);
    if (!isAllowed) return;
    if (uniqueTags.indexOf(tag) === -1) uniqueTags.push(tag);
  });
  inferTeamTags_(fullTeamMap, combinedText).forEach(function (tag) {
    if (uniqueTags.length < 4 && uniqueTags.indexOf(tag) === -1) uniqueTags.push(tag);
  });
  inferEventTags_(combinedText).forEach(function (tag) {
    if (uniqueTags.length < 4 && uniqueTags.indexOf(tag) === -1) uniqueTags.push(tag);
  });
  const hasSpecificEventTag = uniqueTags.some(function (tag) {
    return allowedEventTags.has(tag) && tag !== FALLBACK_EVENT_TAG;
  });
  if (!hasSpecificEventTag && uniqueTags.length < 4) {
    const inferredFallback = inferPrimaryEventTagFromDescriptor_(article.eventDescriptor);
    if (inferredFallback && uniqueTags.indexOf(inferredFallback) === -1) {
      uniqueTags.push(inferredFallback);
    }
  }
  if (!Array.isArray(rawTags)) {
    warnings.push('Gemini未返回标签数组，代码已重新生成标签。');
  } else if (uniqueTags.length !== rawTags.length) {
    warnings.push('Gemini标签已由代码去重、过滤或修补；英文缩写和无关词不会进入标签。');
  }
  return { tags: uniqueTags.slice(0, 4), warnings: warnings };
}

function isSupportedSubjectTag_(tag, text) {
  const cleanTag = sanitizeSingleLine_(tag);
  if (cleanTag.length < 2 || cleanTag.length > 18) return false;
  if (/https?:|www\.|[#@]/i.test(cleanTag)) return false;
  if (!/[\u3400-\u9fff]/.test(cleanTag)) return false;
  const normalizedTag = normalizeCompactText_(cleanTag);
  const normalizedText = normalizeCompactText_(text);
  return normalizedTag.length >= 2 && normalizedText.indexOf(normalizedTag) !== -1;
}

function inferTeamTags_(teamMap, text) {
  const result = [];
  Object.keys(teamMap || {}).forEach(function (key) {
    const value = teamMap[key];
    const terms = collectSearchableTerms_(key, value);
    const expandedTerms = [];
    terms.forEach(function (term) {
      const cleanTerm = sanitizeSingleLine_(term);
      if (!cleanTerm) return;
      expandedTerms.push(cleanTerm);
      const words = cleanTerm.split(/\s+/);
      const lastWord = words[words.length - 1];
      if (/^[A-Za-z0-9]+$/.test(lastWord) && lastWord.length >= 4) {
        expandedTerms.push(lastWord);
      }
    });
    const matched = expandedTerms.some(function (term) {
      return searchTermMatchesText_(term, text);
    });
    if (!matched) return;
    const teamTag = getPreferredTeamTag_(key, value);
    if (teamTag && result.indexOf(teamTag) === -1) result.push(teamTag);
  });
  return result.slice(0, 2);
}

function getPreferredTeamTag_(key, value) {
  if (typeof value === 'string') {
    return containsChinese_(value) ? value.trim() : sanitizeSingleLine_(key);
  }
  if (Array.isArray(value)) {
    const chineseItems = value
      .map(sanitizeSingleLine_)
      .filter(function (item) { return containsChinese_(item); });
    if (chineseItems.length > 0) return chineseItems[0];
    return sanitizeSingleLine_(key);
  }
  if (value && typeof value === 'object') {
    const preferredFields = ['chinese', 'zh', 'shortName', 'displayName', 'name'];
    for (let i = 0; i < preferredFields.length; i++) {
      const fieldValue = value[preferredFields[i]];
      if (
        typeof fieldValue === 'string' && fieldValue.trim() && containsChinese_(fieldValue)
      ) {
        return fieldValue.trim();
      }
    }
    const terms = collectSearchableTerms_(key, value);
    const chineseTerm = terms.find(function (item) { return containsChinese_(item); });
    if (chineseTerm) return sanitizeSingleLine_(chineseTerm);
  }
  return sanitizeSingleLine_(key);
}

function inferEventTags_(text) {
  const rules = [
    ['交易流言', /trade target|trade rumor|linked to|interest in|interested in|exploratory|could .*trade|交易流言|交易兴趣|兴趣.*夸大/i],
    ['法律事务', /attorneys?|lawsuit|court|charges?|motion to dismiss|legal|indict|司法|诉讼|指控|法院/i],
    ['搬迁', /relocat|move the team|move team|搬迁|迁队/i],
    ['球馆', /arena|stadium|center upgrades?|renovation|球馆|场馆|翻修/i],
    ['球队经营', /ownership|team sale|public funding|business operations?|球队经营|所有权|拨款/i],
    ['续约', /re-sign|re sign|extension|续约/i],
    ['签约', /agree(?:s|d)? to .*deal|sign(?:s|ed|ing)?|joins?|签约|加盟/i],
    ['交易', /traded?|acquire(?:s|d)?|deal sends|交易达成|被交易/i],
    ['裁员', /waive(?:s|d)?|release(?:s|d)?|roster cut|裁员|被裁/i],
    ['伤病', /injur|surgery|out for|diagnos|伤病|手术|缺阵/i],
    ['复出', /return(?:s|ed)?|cleared to play|复出|回归/i],
    ['停赛', /suspend(?:s|ed|sion)?|停赛/i],
    ['调查', /investigat|probe|调查/i],
    ['处罚', /fine(?:d)?|penalt|disciplin|处罚|罚款/i],
    ['主教练', /head coach|coach(?:ing)? hire|主教练/i],
    ['管理层', /general manager|president of basketball|front office|executive|管理层|总经理|高管/i],
    ['选秀', /draft|选秀/i],
    ['工资帽', /salary cap|luxury tax|apron|工资帽|奢侈税/i],
    ['劳资协议', /collective bargaining agreement|labor agreement|劳资协议/i],
    ['自由市场', /free agen|自由市场/i],
    ['退役', /retire|退役/i],
    ['比赛', /defeat|beat|win|loss|final score|比赛结果|击败/i],
    ['数据表现', /career-high|triple-double|double-double|points|rebounds|assists|数据表现/i],
    ['球员言论', /says?|said|comments?|believes?|compares?|praises?|criticizes?|表示|认为|称赞|批评/i],
    ['球队前景', /contender|outlook|expectations?|争冠|前景|展望/i],
    ['合同', /contract|deal|合同/i],
    ['联盟政策', /league rule|nba policy|联盟政策|规则变化/i],
    ['官宣', /officially|announc|官方宣布|官宣/i]
  ];
  const result = [];
  rules.forEach(function (rule) {
    const tag = rule[0];
    if (tag === '签约' && result.indexOf('续约') !== -1) return;
    if (tag === '交易' && result.indexOf('交易流言') !== -1) return;
    if (result.length < 2 && rule[1].test(String(text || ''))) result.push(tag);
  });
  return result;
}

function inferPrimaryEventTagFromDescriptor_(descriptor) {
  const map = {
    extension: '续约',
    signing: '签约',
    trade_rumor: '交易流言',
    trade: '交易',
    waiver: '裁员',
    injury: '伤病',
    return: '复出',
    suspension: '停赛',
    coach: '主教练',
    executive: '管理层',
    draft: '选秀',
    investigation: '调查',
    legal: '法律事务',
    arena: '球馆',
    ownership: '球队经营',
    retirement: '退役',
    game: '比赛',
    comment: '球员言论',
    general: FALLBACK_EVENT_TAG
  };
  return map[descriptor && descriptor.type] || FALLBACK_EVENT_TAG;
}

function buildAllowedTeamTagSet_(teamMap) {
  const result = new Set();
  Object.keys(teamMap || {}).forEach(function (key) {
    const preferred = getPreferredTeamTag_(key, teamMap[key]);
    if (preferred && containsChinese_(preferred)) result.add(preferred);
  });
  return result;
}

function buildJekyllMarkdown_(editorial, article) {
  const formattedDate = Utilities.formatDate(
    new Date(),
    CONFIG.TIMEZONE,
    'yyyy-MM-dd HH:mm:ss'
  );
  const safeTitle = sanitizeYamlTitle_(editorial.title);
  const yamlTags = editorial.tags.map(function (tag) {
    return yamlQuote_(tag);
  }).join(', ');
  const highlightLines = editorial.highlights.map(function (item) {
    return `- ${item}`;
  });
  const reports = getArticleReports_(article);
  const sourceLines = buildSourceLines_(reports);
  return [
    '---',
    'layout: post',
    `title: ${yamlQuote_(safeTitle)}`,
    `date: ${formattedDate} +0800`,
    'categories: [nba, news]',
    `tags: [${yamlTags}]`,
    `source_name: ${yamlQuote_(article.source)}`,
