function loadPublishedEventMemory_() {
  const props = PropertiesService.getScriptProperties();
  const raw = props.getProperty(CONFIG.EVENT_MEMORY_PROPERTY);
  let memory = [];

  if (raw) {
    try {
      const parsed = JSON.parse(raw);
