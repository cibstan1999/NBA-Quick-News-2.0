  return lines.join('\n');
}

function buildRecentEventsInstruction_(eventMemory) {
  const cutoff =
    new Date().getTime() - CONFIG.EVENT_DEDUPE_WINDOW_HOURS * 60 * 60 * 1000;
  const recent = (eventMemory || [])
    .filter(function (item) { return Number(item.timestamp) >= cutoff; })
    .slice(0, CONFIG.MAX_RECENT_EVENTS_FOR_GEMINI);
  if (recent.length === 0) {
    return [
      '',
      '【最近48小时已发布事件】',
      '事件记忆为空。仍需对同一组输入素材内部进行去重。'
    ].join('\n');
  }
  const lines = [
    '',
    '【最近48小时已发布事件】',
    '候选新闻若与下列事件属于同一核心事件且无实质新进展，必须REJECT：'
  ];
  recent.forEach(function (item, index) {
