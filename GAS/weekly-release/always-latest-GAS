function rememberPublishedEvent_(memory, article, publishedTitle, eventCore) {
  const descriptor = article.eventDescriptor;
  const item = {
    timestamp: new Date().getTime(),
    eventHash: descriptor.eventHash,
    family: descriptor.family,
    stage: descriptor.stage,
    canonicalTopic: descriptor.canonicalTopic || '',
    primaryTeamKeys: descriptor.primaryTeamKeys.slice(0, 3),
    teamKeys: descriptor.teamKeys.slice(0, 4),
    subjectTokens: descriptor.subjectTokens.slice(0, 6),
    topicTokens: descriptor.topicTokens.slice(0, 8),
    factTokens: descriptor.factTokens.slice(0, 8),
    titleFingerprint: descriptor.titleFingerprint.slice(0, 10),
    eventCore: truncateText_(eventCore || '', 120),
    sourceTitle: truncateText_(article.title, 140),
    publishedTitle: truncateText_(publishedTitle, 100)
  };

  memory.unshift(item);

  const seen = new Set();
  const trimmed = memory.filter(function (entry) {
    const key = String(entry.eventHash || '') + '|' + String(entry.sourceTitle || '');
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  }).slice(0, CONFIG.EVENT_MEMORY_MAX_ITEMS);

  memory.length = 0;
  Array.prototype.push.apply(memory, trimmed);
  savePublishedEventMemory_(memory);
}

function savePublishedEventMemory_(memory) {
  const props = PropertiesService.getScriptProperties();
  let trimmed = (memory || []).slice(0, CONFIG.EVENT_MEMORY_MAX_ITEMS);

  try {
    props.setProperty(CONFIG.EVENT_MEMORY_PROPERTY, JSON.stringify(trimmed));
  } catch (error) {
    trimmed = trimmed.slice(0, 28);
    try {
      props.setProperty(CONFIG.EVENT_MEMORY_PROPERTY, JSON.stringify(trimmed));
      Logger.log('⚠️ 事件记忆接近 Properties 大小上限，已自动缩减为 28 条。');
    } catch (secondError) {
      Logger.log('⚠️ 事件记忆保存失败，但文章发布流程继续：' + formatError_(secondError));
    }
  }
}

